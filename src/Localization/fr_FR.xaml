<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCImageRotaterSetup" xml:space="preserve">Configuration</sys:String>
    <sys:String x:Key="LOCImageRotaterTools" xml:space="preserve">Outils</sys:String>
    <sys:String x:Key="LOCImageRotaterAdvanced" xml:space="preserve">Avancé</sys:String>
    <sys:String x:Key="LOCImageRotaterAdvancedIntro" xml:space="preserve">Options de diagnostic et de débogage pour dépanner ImageRotater. Vous n’en avez normalement pas besoin au quotidien.</sys:String>
    <sys:String x:Key="LOCImageRotaterDiagnostics" xml:space="preserve">DIAGNOSTIC</sys:String>
    <sys:String x:Key="LOCImageRotaterDebugRecommendation" xml:space="preserve">Recommandé : laissez les logs de débogage désactivés en usage normal. Activez-les uniquement pour reproduire un problème, puis désactivez-les une fois le journal récupéré.</sys:String>
    <sys:String x:Key="LOCImageRotaterGeneral" xml:space="preserve">Général</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgrounds" xml:space="preserve">Arrière-plans</sys:String>
    <sys:String x:Key="LOCImageRotaterAnimationFilter" xml:space="preserve">Animation</sys:String>
    <sys:String x:Key="LOCImageRotaterCovers" xml:space="preserve">Jaquettes</sys:String>
    <sys:String x:Key="LOCImageRotaterLibrary" xml:space="preserve">Bibliothèque</sys:String>
    <sys:String x:Key="LOCImageRotaterMaintenance" xml:space="preserve">Outils de bibliothèque</sys:String>
    <sys:String x:Key="LOCImageRotaterMigration" xml:space="preserve">Migration</sys:String>
    <sys:String x:Key="LOCImageRotaterSetupIntro" xml:space="preserve">Intégrations facultatives pour la recherche d’illustrations et les vidéos. ImageRotater fonctionne sans elles : configurez uniquement les fonctions dont vous avez besoin.</sys:String>
    <sys:String x:Key="LOCImageRotaterSteamGridDB" xml:space="preserve">SteamGridDB</sys:String>
    <sys:String x:Key="LOCImageRotaterSteamGridDBHelp" xml:space="preserve">Facultatif. Ajoute les illustrations SteamGridDB à la recherche en ligne. Créez une clé API gratuite sur SteamGridDB puis collez-la ci-dessous.</sys:String>
    <sys:String x:Key="LOCImageRotaterApiKey" xml:space="preserve">Clé API</sys:String>
    <sys:String x:Key="LOCImageRotaterApiKeyStorage" xml:space="preserve">La clé est enregistrée en clair dans les paramètres Playnite. Elle donne uniquement accès aux illustrations publiques SteamGridDB et peut être régénérée à tout moment.</sys:String>
    <sys:String x:Key="LOCImageRotaterFfmpeg" xml:space="preserve">ffmpeg</sys:String>
    <sys:String x:Key="LOCImageRotaterFfmpegHelp" xml:space="preserve">Recommandé pour les contenus animés. Convertit les GIF en MP4 plus légers et sert aussi au téléchargement et à la réparation des vidéos.</sys:String>
    <sys:String x:Key="LOCImageRotaterYtDlp" xml:space="preserve">yt-dlp</sys:String>
    <sys:String x:Key="LOCImageRotaterYtDlpHelp" xml:space="preserve">Facultatif. Permet de télécharger des vidéos depuis YouTube et les sites compatibles. Nécessite ffmpeg et un moteur JavaScript comme Deno.</sys:String>
    <sys:String x:Key="LOCImageRotaterDeno" xml:space="preserve">deno</sys:String>
    <sys:String x:Key="LOCImageRotaterDenoHelp" xml:space="preserve">Nécessaire uniquement pour YouTube via yt-dlp. Indiquez le chemin vers deno.exe, ou placez-le à côté de yt-dlp.exe pour qu’il soit détecté automatiquement.</sys:String>
    <sys:String x:Key="LOCImageRotaterCheckingTools" xml:space="preserve">Vérification des outils...</sys:String>
    <sys:String x:Key="LOCImageRotaterToolPathHint" xml:space="preserve">Laissez le chemin vide si l’outil est déjà disponible dans le PATH Windows. Sinon, sélectionnez directement son exécutable.</sys:String>
    <sys:String x:Key="LOCImageRotaterBrowse" xml:space="preserve">Parcourir…</sys:String>
    <sys:String x:Key="LOCImageRotaterGeneralIntro" xml:space="preserve">Configurez ici l’essentiel. Choisissez ce qu’ImageRotater doit gérer, puis affinez les arrière-plans et les jaquettes dans leurs pages dédiées.</sys:String>
    <sys:String x:Key="LOCImageRotaterMasterDescription" xml:space="preserve">Activez ou désactivez tout le plugin depuis un seul endroit. Le désactiver met en pause la rotation et les contenus animés sans supprimer vos images ni modifier vos réglages.</sys:String>
    <sys:String x:Key="LOCImageRotaterChooseContent" xml:space="preserve">CHOISISSEZ CE QU’IMAGEROTATER DOIT GÉRER</sys:String>
    <sys:String x:Key="LOCImageRotaterChooseContentHint" xml:space="preserve">Les deux fonctions sont indépendantes. Activez uniquement ce dont vous avez besoin, puis configurez leur comportement dans leur page dédiée.</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundCardTitle" xml:space="preserve">Arrière-plans</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundCardText" xml:space="preserve">Faites tourner les arrière-plans des jeux et réglez la sélection, le diaporama, le démarrage des vidéos et les transitions.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverCardTitle" xml:space="preserve">Jaquettes</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverCardText" xml:space="preserve">Faites tourner les jaquettes des jeux et réglez la sélection, le diaporama, les animations et les transitions.</sys:String>
    <sys:String x:Key="LOCImageRotaterConfigureBackgrounds" xml:space="preserve">Configurer les arrière-plans</sys:String>
    <sys:String x:Key="LOCImageRotaterConfigureCovers" xml:space="preserve">Configurer les jaquettes</sys:String>
    <sys:String x:Key="LOCImageRotaterAdvancedAndSupport" xml:space="preserve">AVANCÉ &amp; DÉPANNAGE</sys:String>
    <sys:String x:Key="LOCImageRotaterToolsCalloutEyebrow" xml:space="preserve">FONCTIONS OPTIONNELLES</sys:String>
    <sys:String x:Key="LOCImageRotaterToolsCalloutTitle" xml:space="preserve">Contenus en ligne et animés</sys:String>
    <sys:String x:Key="LOCImageRotaterToolsCalloutText" xml:space="preserve">ImageRotater fonctionne sans outil externe. Pour ajouter des sources et les fonctions vidéo, configurez-les une fois dans Outils : SteamGridDB ajoute davantage d’illustrations, ffmpeg gère les contenus animés/vidéo, et YouTube utilise yt-dlp + ffmpeg + Deno.</sys:String>
    <sys:String x:Key="LOCImageRotaterToolsCalloutNote" xml:space="preserve">Si vous utilisez seulement des images locales, Steam ou des images web classiques, vous pouvez laisser ces outils non configurés.</sys:String>
    <sys:String x:Key="LOCImageRotaterOpenTools" xml:space="preserve">Ouvrir les outils</sys:String>
    <sys:String x:Key="LOCImageRotaterRotation" xml:space="preserve">ROTATION</sys:String>
    <sys:String x:Key="LOCImageRotaterTabRotation" xml:space="preserve">Rotation</sys:String>
    <sys:String x:Key="LOCImageRotaterTabAnimation" xml:space="preserve">Affichage &amp; animation</sys:String>
    <sys:String x:Key="LOCImageRotaterTabOnlineSources" xml:space="preserve">Sources en ligne</sys:String>
    <sys:String x:Key="LOCImageRotaterTabVideoTools" xml:space="preserve">Outils vidéo</sys:String>
    <sys:String x:Key="LOCImageRotaterTabPerformance" xml:space="preserve">Performance</sys:String>
    <sys:String x:Key="LOCImageRotaterTabDebug" xml:space="preserve">Débogage</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableRotation" xml:space="preserve">ImageRotater</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableRotationHint" xml:space="preserve">Interrupteur principal. Le désactiver arrête toute rotation et tout contenu animé sans supprimer vos fichiers ni vos réglages.</sys:String>
    <sys:String x:Key="LOCImageRotaterTroubleshooting" xml:space="preserve">DÉPANNAGE</sys:String>
    <sys:String x:Key="LOCImageRotaterExpertTools" xml:space="preserve">OUTILS EXPERTS</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableDebug" xml:space="preserve">Activer les logs de débogage</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableDebugHint" xml:space="preserve">Crée un journal ImageRotater.log détaillé pour le diagnostic. Laissez cette option désactivée en usage normal.</sys:String>
    <sys:String x:Key="LOCImageRotaterOpenDebugLogFolder" xml:space="preserve">Ouvrir le dossier du journal de débogage</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundIntro" xml:space="preserve">Choisissez quand les arrière-plans changent, comment les formats inhabituels sont affichés et quelle transition est utilisée.</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableBackgrounds" xml:space="preserve">Activer la rotation des arrière-plans</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableBackgroundsHint" xml:space="preserve">Contrôle uniquement les arrière-plans. Les réglages des jaquettes ne sont pas modifiés.</sys:String>
    <sys:String x:Key="LOCImageRotaterShape" xml:space="preserve">FORMAT</sys:String>
    <sys:String x:Key="LOCImageRotaterLetterbox" xml:space="preserve">Adapter les formats inhabituels au lieu de les recadrer</sys:String>
    <sys:String x:Key="LOCImageRotaterLetterboxHint" xml:space="preserve">Utile pour les images ultra-larges, carrées ou de type bannière. L’image d’origine reste intacte et est posée sur un remplissage flouté pour s’adapter à l’écran. Ce traitement supplémentaire peut demander plus de ressources lors des changements d’arrière-plan ; laissez l’option désactivée si vous n’en avez pas besoin.</sys:String>
    <sys:String x:Key="LOCImageRotaterLevelBackgrounds" xml:space="preserve">Garder un flou cohérent entre les arrière-plans</sys:String>
    <sys:String x:Key="LOCImageRotaterLevelBackgroundsHint" xml:space="preserve">Uniformise la largeur publiée des arrière-plans afin que Playnite applique un flou similaire entre des images de résolutions différentes. Les fichiers d’origine ne sont pas modifiés. Ce traitement supplémentaire peut demander plus de ressources lors des changements d’arrière-plan ; laissez l’option désactivée si vous n’en avez pas besoin.</sys:String>
    <sys:String x:Key="LOCImageRotaterWhenSeveral" xml:space="preserve">QUAND UN JEU EN POSSÈDE PLUSIEURS</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundSeveralHint" xml:space="preserve">Choisissez ce qui se passe lorsqu’un jeu possède plusieurs arrière-plans. Les jeux avec une seule image ne changent pas.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickSession" xml:space="preserve">Session</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundPickSessionHint" xml:space="preserve">Garde le même arrière-plan pendant toute la session Playnite. Au prochain lancement, un arrière-plan différent est choisi lorsque c’est possible.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickEverySelection" xml:space="preserve">Choisir une nouvelle image à chaque sélection du jeu</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundPickEveryHint" xml:space="preserve">Change l’arrière-plan chaque fois que vous revenez sur le jeu.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickFixed" xml:space="preserve">Illustration fixe</sys:String>
    <sys:String x:Key="LOCImageRotaterPickFixedHint" xml:space="preserve">Utilise toujours l’illustration marquée comme Illustration fixe dans le gestionnaire. Si aucune n’est choisie, la première dans l’ordre du gestionnaire est utilisée.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickSlideshow" xml:space="preserve">Diaporama</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundPickSlideshowHint" xml:space="preserve">Fait défiler automatiquement les arrière-plans du jeu tant que vous restez dessus.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverPickSlideshowHint" xml:space="preserve">Fait défiler automatiquement les jaquettes du jeu sélectionné tant que vous restez dessus.</sys:String>
    <sys:String x:Key="LOCImageRotaterSlideshowInterval" xml:space="preserve">Intervalle du diaporama</sys:String>
    <sys:String x:Key="LOCImageRotaterSlideshow" xml:space="preserve">DIAPORAMA</sys:String>
    <sys:String x:Key="LOCImageRotaterChangeEvery" xml:space="preserve">Changer toutes les</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundSlideshowHint" xml:space="preserve">Durée d’affichage de chaque arrière-plan avant de passer au suivant. Disponible uniquement avec le mode Diaporama.</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundAnimation" xml:space="preserve">Animation des arrière-plans</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundAnimationIntro" xml:space="preserve">Définit comment un arrière-plan fixe laisse place au suivant. Les vidéos et GIF conservent leurs propres fondus.</sys:String>
    <sys:String x:Key="LOCImageRotaterTransition" xml:space="preserve">TRANSITION</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundTransitionHint" xml:space="preserve">Transition utilisée entre deux arrière-plans fixes. Le fondu croisé est le choix le plus fluide. Il faut au moins deux arrière-plans pour voir une transition.</sys:String>
    <sys:String x:Key="LOCImageRotaterCrossfade" xml:space="preserve">Fondu enchaîné</sys:String>
    <sys:String x:Key="LOCImageRotaterFadeBlack" xml:space="preserve">Fondu par le noir</sys:String>
    <sys:String x:Key="LOCImageRotaterFadeWhite" xml:space="preserve">Fondu par le blanc</sys:String>
    <sys:String x:Key="LOCImageRotaterSlideRight" xml:space="preserve">Glissement depuis la droite</sys:String>
    <sys:String x:Key="LOCImageRotaterCut" xml:space="preserve">Coupe directe (sans animation)</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverIntro" xml:space="preserve">Réglez la rotation des jaquettes dans la grille et les vues détaillées, y compris le comportement des jaquettes animées et des vidéos.</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableCovers" xml:space="preserve">Activer la rotation des jaquettes</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableCoversHint" xml:space="preserve">Contrôle uniquement les jaquettes. Les réglages des arrière-plans ne sont pas modifiés.</sys:String>
    <sys:String x:Key="LOCImageRotaterAnimateUnfocused" xml:space="preserve">Lire les jaquettes animées sur toutes les tuiles visibles, pas seulement la sélection</sys:String>
    <sys:String x:Key="LOCImageRotaterAnimateUnfocusedHint" xml:space="preserve">Option gourmande. Chaque jaquette animée visible consomme des ressources, surtout dans les grandes grilles. Désactivez-la si vous constatez des saccades, un défilement lent ou une forte consommation mémoire.</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStart" xml:space="preserve">Lecture des vidéos</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartBeginning" xml:space="preserve">Démarrer les vidéos de jaquette au début</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartBeginningHint" xml:space="preserve">Recommandé. Démarre à 0:00 et évite le repositionnement initial qui peut provoquer un petit à-coup pendant la navigation.</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartRandom" xml:space="preserve">Démarrer les vidéos de jaquette à une position aléatoire</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartRandomHint" xml:space="preserve">Rend les jaquettes animées moins répétitives, mais chaque vidéo doit se repositionner après son ouverture et peut provoquer un petit à-coup.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverSeveralHint" xml:space="preserve">Choisissez ce qui se passe lorsqu’un jeu possède plusieurs jaquettes.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverPickSessionHint" xml:space="preserve">Garde la même jaquette pendant toute la session Playnite. Au prochain lancement, une jaquette différente est choisie lorsque c’est possible.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverPickEveryHint" xml:space="preserve">Change la tuile chaque fois que vous revenez sur le jeu. Plus dynamique, mais la grille se réorganise pendant la navigation.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverSlideshowHint" xml:space="preserve">Durée d’affichage de chaque jaquette avant de passer à la suivante. Disponible uniquement avec le mode Diaporama.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverAnimation" xml:space="preserve">Animation des jaquettes</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverAnimationIntro" xml:space="preserve">Définit comment une jaquette fixe laisse place à la suivante, dans une grille ou dans la vue détaillée. Les vidéos et GIF conservent leurs propres fondus.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverTransitionHint" xml:space="preserve">Transition utilisée entre deux jaquettes fixes. Les jaquettes animées et vidéos conservent leur propre lecture. Il faut au moins deux jaquettes.</sys:String>
    <sys:String x:Key="LOCImageRotaterLibraryIntro" xml:space="preserve">Importez, optimisez, convertissez et restaurez les illustrations stockées par ImageRotater. Ces actions agissent directement sur la bibliothèque du plugin.</sys:String>
    <sys:String x:Key="LOCImageRotaterConvert" xml:space="preserve">CONVERTIR</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseImages" xml:space="preserve">Optimiser les images stockées</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseImagesHint" xml:space="preserve">Réencode les grandes images opaques compatibles en JPEG haute qualité lorsqu’un gain d’au moins 10 % d’espace disque est obtenu. Les images avec transparence et les fichiers qui ne gagneraient presque rien sont laissés tels quels. Les fichiers sont remplacés et cette opération ne peut pas être annulée.</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseImagesButton" xml:space="preserve">Optimiser les images stockées</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertGifs" xml:space="preserve">Convertir tous les GIF en MP4</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertGifsHint" xml:space="preserve">Recommandé si vous utilisez des GIF animés. Les MP4 sont généralement beaucoup plus légers et plus efficaces à lire. Nécessite ffmpeg.</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertJpegs" xml:space="preserve">Convertir tous les JPEG en PNG</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertJpegsHint" xml:space="preserve">Généralement inutile. Le PNG est sans perte mais peut prendre beaucoup plus d’espace disque, et la conversion ne récupère pas la qualité déjà perdue en JPEG.</sys:String>
    <sys:String x:Key="LOCImageRotaterRepair" xml:space="preserve">RÉPARER</sys:String>
    <sys:String x:Key="LOCImageRotaterRepairVideos" xml:space="preserve">Réparer les vidéos</sys:String>
    <sys:String x:Key="LOCImageRotaterRepairVideosHint" xml:space="preserve">À utiliser si des vidéos téléchargées apparaissent comme des tuiles noires. Le conteneur vidéo est reconstruit sans réencodage : la qualité reste identique. Nécessite ffmpeg.</sys:String>
    <sys:String x:Key="LOCImageRotaterRepairVideosButton" xml:space="preserve">Réparer les vidéos (corriger les tuiles noires)</sys:String>
    <sys:String x:Key="LOCImageRotaterRepairArtwork" xml:space="preserve">Réparer les références d’illustrations</sys:String>
    <sys:String x:Key="LOCImageRotaterRepairArtworkHint" xml:space="preserve">À utiliser si un jeu pointe vers une illustration ImageRotater qui n’existe plus et apparaît en noir. Les références cassées sont nettoyées ; aucun fichier n’est supprimé.</sys:String>
    <sys:String x:Key="LOCImageRotaterRecovery" xml:space="preserve">RÉCUPÉRATION</sys:String>
    <sys:String x:Key="LOCImageRotaterRestoreOriginalBackgrounds" xml:space="preserve">Restaurer les arrière-plans Playnite d’origine</sys:String>
    <sys:String x:Key="LOCImageRotaterRestoreOriginalBackgroundsHint" xml:space="preserve">Restaure l’arrière-plan que chaque jeu possédait avant son remplacement par ImageRotater. La bibliothèque d’illustrations ImageRotater n’est pas supprimée : seuls les arrière-plans Playnite sauvegardés sont restaurés.</sys:String>
    <sys:String x:Key="LOCImageRotaterRestoreOriginalBackgroundsButton" xml:space="preserve">Restaurer les arrière-plans d’origine</sys:String>
    <sys:String x:Key="LOCImageRotaterDangerZone" xml:space="preserve">ZONE À RISQUE</sys:String>
    <sys:String x:Key="LOCImageRotaterResetLibrary" xml:space="preserve">Réinitialiser la bibliothèque</sys:String>
    <sys:String x:Key="LOCImageRotaterResetLibraryHint" xml:space="preserve">Supprime toutes les images et vidéos stockées par ImageRotater et restaure les illustrations que les jeux avaient avant l’intervention du plugin. Les contenus téléchargés via ImageRotater seront définitivement supprimés.</sys:String>
    <sys:String x:Key="LOCImageRotaterResetLibraryButton" xml:space="preserve">Supprimer toutes les illustrations du plugin et restaurer les originales</sys:String>
    <sys:String x:Key="LOCImageRotaterMigrationIntro" xml:space="preserve">Vous utilisiez déjà BackgroundChanger ? Vous pouvez copier ses illustrations existantes vers ImageRotater sans rien supprimer de l’ancien plugin.</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundChanger" xml:space="preserve">BACKGROUNDCHANGER</sys:String>
    <sys:String x:Key="LOCImageRotaterImportBackgroundChanger" xml:space="preserve">Importer les illustrations de BackgroundChanger</sys:String>
    <sys:String x:Key="LOCImageRotaterImportBackgroundChangerHint" xml:space="preserve">Copie les jaquettes et arrière-plans existants de BackgroundChanger vers ImageRotater, jeu par jeu. Désactivez BackgroundChanger après l’import pour éviter que les deux plugins contrôlent les mêmes illustrations.</sys:String>
    <sys:String x:Key="LOCImageRotaterImportWebPHint" xml:space="preserve">Les fichiers WebP sont copiés tels quels. Playnite ne peut pas les afficher nativement ; utilisez les outils de conversion dans Bibliothèque &gt; Outils de bibliothèque si nécessaire.</sys:String>
    <sys:String x:Key="LOCImageRotaterSteam" xml:space="preserve">Steam</sys:String>
    <sys:String x:Key="LOCImageRotaterWebSearch" xml:space="preserve">Recherche web</sys:String>
    <sys:String x:Key="LOCImageRotaterYouTube" xml:space="preserve">YouTube</sys:String>
    <sys:String x:Key="LOCImageRotaterSteamSearchHelp" xml:space="preserve">Illustrations officielles de la bibliothèque Steam. Fonctionne pour tout jeu vendu sur Steam, même si votre copie vient d’un autre magasin. Aucune clé requise.</sys:String>
    <sys:String x:Key="LOCImageRotaterSgdbSearchHelp" xml:space="preserve">Illustrations sélectionnées sur SteamGridDB, filtrables par format et style. Les aperçus animés nécessitent ffmpeg.</sys:String>
    <sys:String x:Key="LOCImageRotaterWebSearchHelp" xml:space="preserve">Images provenant du web. La qualité et le format varient : vérifiez les dimensions avant de choisir.</sys:String>
    <sys:String x:Key="LOCImageRotaterYouTubeSearchHelp" xml:space="preserve">Vidéos de type live wallpaper enregistrées en MP4. Nécessite yt-dlp, ffmpeg et deno ; voir l’onglet Outils.</sys:String>
    <sys:String x:Key="LOCImageRotaterShapeAndSize" xml:space="preserve">Format et taille</sys:String>
    <sys:String x:Key="LOCImageRotaterStyle" xml:space="preserve">Style</sys:String>
    <sys:String x:Key="LOCImageRotaterGifConvertHint" xml:space="preserve">Fichiers plus petits et lecture plus fluide qu’un GIF animé.</sys:String>
    <sys:String x:Key="LOCImageRotaterAlsoShow" xml:space="preserve">Afficher aussi</sys:String>
    <sys:String x:Key="LOCImageRotaterAnimatedBadge" xml:space="preserve">ANIMÉ</sys:String>
    <sys:String x:Key="LOCImageRotaterPreview" xml:space="preserve">Aperçu</sys:String>
    <sys:String x:Key="LOCImageRotaterSearch" xml:space="preserve">Rechercher</sys:String>
    <sys:String x:Key="LOCImageRotaterFilters" xml:space="preserve">Filtres</sys:String>
    <sys:String x:Key="LOCImageRotaterShowAnimated" xml:space="preserve">Rechercher du contenu animé</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertGifsOnDownload" xml:space="preserve">Convertir les GIF en MP4 au téléchargement</sys:String>
    <sys:String x:Key="LOCImageRotaterAdultContent" xml:space="preserve">Contenu adulte</sys:String>
    <sys:String x:Key="LOCImageRotaterHumour" xml:space="preserve">Humour</sys:String>
    <sys:String x:Key="LOCImageRotaterFlashingImages" xml:space="preserve">Images clignotantes</sys:String>
    <sys:String x:Key="LOCImageRotaterClose" xml:space="preserve">Fermer</sys:String>
    <sys:String x:Key="LOCImageRotaterDownloadSelected" xml:space="preserve">Télécharger la sélection</sys:String>
    <sys:String x:Key="LOCImageRotaterSelectTooltip" xml:space="preserve">Cliquez pour sélectionner. Vous pouvez en choisir plusieurs puis utiliser Télécharger la sélection.</sys:String>
    <sys:String x:Key="LOCImageRotaterPreviewFullTooltip" xml:space="preserve">Aperçu en taille réelle</sys:String>
    <sys:String x:Key="LOCImageRotaterClosePreviewTooltip" xml:space="preserve">Fermer l’aperçu</sys:String>
