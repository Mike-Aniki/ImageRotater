<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCImageRotaterSetup" xml:space="preserve">Setup</sys:String>
    <sys:String x:Key="LOCImageRotaterTools" xml:space="preserve">Tools</sys:String>
    <sys:String x:Key="LOCImageRotaterAdvanced" xml:space="preserve">Advanced</sys:String>
    <sys:String x:Key="LOCImageRotaterAdvancedIntro" xml:space="preserve">Diagnostics and debug options for troubleshooting ImageRotater. You normally do not need these options during everyday use.</sys:String>
    <sys:String x:Key="LOCImageRotaterDiagnostics" xml:space="preserve">DIAGNOSTICS</sys:String>
    <sys:String x:Key="LOCImageRotaterDebugRecommendation" xml:space="preserve">Recommended: keep debug logging off during normal use. Enable it only while reproducing a problem, then disable it again once you have the log.</sys:String>
    <sys:String x:Key="LOCImageRotaterGeneral" xml:space="preserve">General</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgrounds" xml:space="preserve">Backgrounds</sys:String>
    <sys:String x:Key="LOCImageRotaterAnimationFilter" xml:space="preserve">Animation</sys:String>
    <sys:String x:Key="LOCImageRotaterCovers" xml:space="preserve">Covers</sys:String>
    <sys:String x:Key="LOCImageRotaterLibrary" xml:space="preserve">Library</sys:String>
    <sys:String x:Key="LOCImageRotaterMaintenance" xml:space="preserve">Library tools</sys:String>
    <sys:String x:Key="LOCImageRotaterMigration" xml:space="preserve">Migration</sys:String>
    <sys:String x:Key="LOCImageRotaterSetupIntro" xml:space="preserve">Optional tools for animated artwork and video. ImageRotater works without them; configure only the features you want to use.</sys:String>
    <sys:String x:Key="LOCImageRotaterSteamGridDB" xml:space="preserve">SteamGridDB</sys:String>
    <sys:String x:Key="LOCImageRotaterSteamGridDBHelp" xml:space="preserve">Optional. Adds SteamGridDB artwork to online search. Create a free API key on SteamGridDB, then paste it below.</sys:String>
    <sys:String x:Key="LOCImageRotaterApiKey" xml:space="preserve">API key</sys:String>
    <sys:String x:Key="LOCImageRotaterApiKeyStorage" xml:space="preserve">The key is stored in Playnite's settings as plain text. It only grants access to public SteamGridDB artwork and can be regenerated at any time.</sys:String>
    <sys:String x:Key="LOCImageRotaterFfmpeg" xml:space="preserve">ffmpeg</sys:String>
    <sys:String x:Key="LOCImageRotaterFfmpegHelp" xml:space="preserve">Recommended for animated artwork. Converts GIFs to smaller MP4 files and is also required for video downloads and video repair.</sys:String>
    <sys:String x:Key="LOCImageRotaterYtDlp" xml:space="preserve">yt-dlp</sys:String>
    <sys:String x:Key="LOCImageRotaterYtDlpHelp" xml:space="preserve">Optional. Enables video downloads from YouTube and supported sites. Requires ffmpeg and a JavaScript runtime such as Deno.</sys:String>
    <sys:String x:Key="LOCImageRotaterDeno" xml:space="preserve">deno</sys:String>
    <sys:String x:Key="LOCImageRotaterDenoHelp" xml:space="preserve">Required only for YouTube through yt-dlp. Point to deno.exe, or keep it next to yt-dlp.exe so it can be detected automatically.</sys:String>
    <sys:String x:Key="LOCImageRotaterCheckingTools" xml:space="preserve">Checking tools...</sys:String>
    <sys:String x:Key="LOCImageRotaterToolPathHint" xml:space="preserve">You can leave a path empty if the tool is already available in Windows PATH. Otherwise, browse to the executable.</sys:String>
    <sys:String x:Key="LOCImageRotaterBrowse" xml:space="preserve">Browse…</sys:String>
    <sys:String x:Key="LOCImageRotaterGeneralIntro" xml:space="preserve">Set up the essentials here. Choose what ImageRotater manages, then fine-tune backgrounds and covers in their dedicated pages.</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeIntegration" xml:space="preserve">Theme integration</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeIntegrationHint" xml:space="preserve">Use this if your Playnite theme supports ImageRotater. This option is recommended as it offers the best performance, supports animated artwork, and keeps Playnite's native covers and backgrounds untouched.</sys:String>
    <sys:String x:Key="LOCImageRotaterCompatibilityModeHint" xml:space="preserve">If your theme is not compatible, turn this off. ImageRotater will then work with almost any theme by updating Playnite's native artwork directly. This can cause extra database updates and may reduce performance when other plugins react to those changes.</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeIntegrationTooltip" xml:space="preserve">Use theme-integrated rendering. Turn it off only when the active theme does not support ImageRotater.</sys:String>
    <sys:String x:Key="LOCImageRotaterActiveThemeSupport" xml:space="preserve">Active theme support</sys:String>
    <sys:String x:Key="LOCImageRotaterDesktopThemeLabel" xml:space="preserve">Desktop:</sys:String>
    <sys:String x:Key="LOCImageRotaterFullscreenThemeLabel" xml:space="preserve">Fullscreen:</sys:String>
    <sys:String x:Key="LOCImageRotaterCheckingThemeSupport" xml:space="preserve">Checking theme support...</sys:String>
    <sys:String x:Key="LOCImageRotaterUnknownTheme" xml:space="preserve">Unknown theme</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeSupportFull" xml:space="preserve">{0} — Compatible (Background + Cover)</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeSupportBackgroundOnly" xml:space="preserve">{0} — Partial support (Background only)</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeSupportCoverOnly" xml:space="preserve">{0} — Partial support (Cover only)</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeSupportNone" xml:space="preserve">{0} — Not compatible</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeSupportUnknown" xml:space="preserve">{0} — Could not check theme files</sys:String>
    <sys:String x:Key="LOCImageRotaterMasterDescription" xml:space="preserve">Turn the plugin on or off in one place. Disabling it pauses rotation and animated artwork without removing your artwork or changing your settings.</sys:String>
    <sys:String x:Key="LOCImageRotaterChooseContent" xml:space="preserve">CHOOSE WHAT IMAGEROTATER MANAGES</sys:String>
    <sys:String x:Key="LOCImageRotaterChooseContentHint" xml:space="preserve">Enable either feature independently. You can configure how each one behaves from its own page.</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundCardTitle" xml:space="preserve">Backgrounds</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundCardText" xml:space="preserve">Rotate game backgrounds and control selection behavior, slideshows, video start position and transitions.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverCardTitle" xml:space="preserve">Covers</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverCardText" xml:space="preserve">Rotate game covers and control selection behavior, slideshows, animation performance and transitions.</sys:String>
    <sys:String x:Key="LOCImageRotaterConfigureBackgrounds" xml:space="preserve">Configure backgrounds</sys:String>
    <sys:String x:Key="LOCImageRotaterConfigureCovers" xml:space="preserve">Configure covers</sys:String>
    <sys:String x:Key="LOCImageRotaterAdvancedAndSupport" xml:space="preserve">ADVANCED &amp; SUPPORT</sys:String>
    <sys:String x:Key="LOCImageRotaterRotation" xml:space="preserve">ROTATION</sys:String>
    <sys:String x:Key="LOCImageRotaterTabRotation" xml:space="preserve">Rotation</sys:String>
    <sys:String x:Key="LOCImageRotaterTabDisplay" xml:space="preserve">Display</sys:String>
    <sys:String x:Key="LOCImageRotaterTabAnimation" xml:space="preserve">Animation</sys:String>
    <sys:String x:Key="LOCImageRotaterTabOnlineSources" xml:space="preserve">Online sources</sys:String>
    <sys:String x:Key="LOCImageRotaterTabVideoTools" xml:space="preserve">Video tools</sys:String>
    <sys:String x:Key="LOCImageRotaterTabPerformance" xml:space="preserve">Performance</sys:String>
    <sys:String x:Key="LOCImageRotaterTabDebug" xml:space="preserve">Debug</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableRotation" xml:space="preserve">ImageRotater</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableRotationHint" xml:space="preserve">Master switch. Turning this off stops all rotation and animated artwork without deleting any files or settings.</sys:String>
    <sys:String x:Key="LOCImageRotaterTroubleshooting" xml:space="preserve">TROUBLESHOOTING</sys:String>
    <sys:String x:Key="LOCImageRotaterExpertTools" xml:space="preserve">EXPERT TOOLS</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableDebug" xml:space="preserve">Enable debug logging</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableDebugHint" xml:space="preserve">Creates a detailed ImageRotater.log for troubleshooting. Keep this off unless you are diagnosing a problem.</sys:String>
    <sys:String x:Key="LOCImageRotaterOpenDebugLogFolder" xml:space="preserve">Open debug log folder</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundIntro" xml:space="preserve">Control when backgrounds change, how unusual image shapes are handled, and which transition is used.</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableBackgrounds" xml:space="preserve">Enable background rotation</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableBackgroundsHint" xml:space="preserve">Controls backgrounds only. Cover settings are not affected.</sys:String>
    <sys:String x:Key="LOCImageRotaterShape" xml:space="preserve">SHAPE</sys:String>
    <sys:String x:Key="LOCImageRotaterLetterbox" xml:space="preserve">Fit unusual background shapes instead of cropping them</sys:String>
    <sys:String x:Key="LOCImageRotaterLetterboxHint" xml:space="preserve">Useful for ultrawide, square or banner images. The original image is kept intact and placed over a blurred fill so it still fits the screen. This extra processing can use more resources during background changes, so leave it off unless you need it.</sys:String>
    <sys:String x:Key="LOCImageRotaterLevelBackgrounds" xml:space="preserve">Keep background blur visually consistent</sys:String>
    <sys:String x:Key="LOCImageRotaterLevelBackgroundsHint" xml:space="preserve">Normalises the published background width so Playnite applies a similar amount of blur when switching between images of different resolutions. Original files are untouched. This extra processing can use more resources during background changes, so leave it off unless you need it.</sys:String>
    <sys:String x:Key="LOCImageRotaterWhenSeveral" xml:space="preserve">WHEN A GAME HAS SEVERAL</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundSeveralHint" xml:space="preserve">Choose what happens when a game has more than one background. Games with a single background are unchanged.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickSession" xml:space="preserve">Session</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundPickSessionHint" xml:space="preserve">Keeps one background for the whole Playnite session. On the next launch, a different background is chosen when possible.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickEverySelection" xml:space="preserve">Choose a new image each time I select the game</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundPickEveryHint" xml:space="preserve">Changes the background whenever you return to the game.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickFixed" xml:space="preserve">Fixed artwork</sys:String>
    <sys:String x:Key="LOCImageRotaterPickFixedHint" xml:space="preserve">Always uses the artwork marked as Fixed artwork in the manager. If none is selected, the first artwork in the manager order is used.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickSlideshow" xml:space="preserve">Slideshow</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundPickSlideshowHint" xml:space="preserve">Automatically cycles through the game's backgrounds while you stay on it.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverPickSlideshowHint" xml:space="preserve">Automatically cycles through the selected game's covers while you stay on it.</sys:String>
    <sys:String x:Key="LOCImageRotaterSlideshowInterval" xml:space="preserve">Slideshow interval</sys:String>
    <sys:String x:Key="LOCImageRotaterSlideshow" xml:space="preserve">SLIDESHOW</sys:String>
    <sys:String x:Key="LOCImageRotaterChangeEvery" xml:space="preserve">Change every</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundSlideshowHint" xml:space="preserve">How long each background stays visible before the slideshow moves to the next artwork. Available only in Slideshow mode.</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundAnimation" xml:space="preserve">Background animation</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundAnimationIntro" xml:space="preserve">How one still background gives way to the next. Videos and GIFs play through and keep their own fades.</sys:String>
    <sys:String x:Key="LOCImageRotaterTransition" xml:space="preserve">TRANSITION</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundTransitionHint" xml:space="preserve">Transition used between still backgrounds. Crossfade is the smoothest default. A game needs at least two backgrounds for a transition to occur.</sys:String>
    <sys:String x:Key="LOCImageRotaterCrossfade" xml:space="preserve">Crossfade</sys:String>
    <sys:String x:Key="LOCImageRotaterFadeBlack" xml:space="preserve">Fade through black</sys:String>
    <sys:String x:Key="LOCImageRotaterFadeWhite" xml:space="preserve">Fade through white</sys:String>
    <sys:String x:Key="LOCImageRotaterSlideRight" xml:space="preserve">Slide from right</sys:String>
    <sys:String x:Key="LOCImageRotaterSideReveal" xml:space="preserve">Side Reveal</sys:String>
    <sys:String x:Key="LOCImageRotaterDiagonalReveal" xml:space="preserve">Diagonal Reveal</sys:String>
    <sys:String x:Key="LOCImageRotaterDepthShift" xml:space="preserve">Cinematic</sys:String>
    <sys:String x:Key="LOCImageRotaterMosaic" xml:space="preserve">Mosaic</sys:String>
    <sys:String x:Key="LOCImageRotaterPixelate" xml:space="preserve">Pixelate</sys:String>
    <sys:String x:Key="LOCImageRotaterZoom" xml:space="preserve">Zoom Out</sys:String>
    <sys:String x:Key="LOCImageRotaterFocus" xml:space="preserve">Focus</sys:String>
    <sys:String x:Key="LOCImageRotaterCut" xml:space="preserve">Cut (no animation)</sys:String>
    <sys:String x:Key="LOCImageRotaterCrossfadeHint" xml:space="preserve">Smoothly blends the old image into the new one.</sys:String>
    <sys:String x:Key="LOCImageRotaterFadeBlackHint" xml:space="preserve">Fades the old image to black, then reveals the next image.</sys:String>
    <sys:String x:Key="LOCImageRotaterFadeWhiteHint" xml:space="preserve">Fades the old image to white, then reveals the next image.</sys:String>
    <sys:String x:Key="LOCImageRotaterSlideRightHint" xml:space="preserve">Slides the next image in from the right.</sys:String>
    <sys:String x:Key="LOCImageRotaterSideRevealHint" xml:space="preserve">Reveals the new image from the side with a soft blended edge.</sys:String>
    <sys:String x:Key="LOCImageRotaterDiagonalRevealHint" xml:space="preserve">Reveals the new image diagonally with a soft blended edge.</sys:String>
    <sys:String x:Key="LOCImageRotaterDepthShiftHint" xml:space="preserve">The old image recedes and softens while the new one moves forward and sharpens into focus.</sys:String>
    <sys:String x:Key="LOCImageRotaterMosaicHint" xml:space="preserve">Reveals the new image through animated mosaic blocks.</sys:String>
    <sys:String x:Key="LOCImageRotaterPixelateHint" xml:space="preserve">Pixelates the image into a retro 16-bit style hand-off.</sys:String>
    <sys:String x:Key="LOCImageRotaterZoomHint" xml:space="preserve">Starts slightly enlarged, then smoothly settles to full frame.</sys:String>
    <sys:String x:Key="LOCImageRotaterFocusHint" xml:space="preserve">Blurs the old image out while the new one fades in blurred and sharpens.</sys:String>
    <sys:String x:Key="LOCImageRotaterCutHint" xml:space="preserve">Switches instantly to the next image with no animation.</sys:String>

    <sys:String x:Key="LOCImageRotaterCoverIntro" xml:space="preserve">Control how covers rotate in the grid and details views, including animated covers and video behaviour.</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableCovers" xml:space="preserve">Enable cover rotation</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableCoversHint" xml:space="preserve">Controls covers only. Background settings are not affected.</sys:String>
    <sys:String x:Key="LOCImageRotaterAnimateUnfocused" xml:space="preserve">Play animated covers on every visible tile, not just the selected one</sys:String>
    <sys:String x:Key="LOCImageRotaterAnimateUnfocusedHint" xml:space="preserve">Plays animated covers on every visible game in the grid instead of only the selected one. This makes the library feel more lively, but may use more system resources on lower-end PCs.</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStart" xml:space="preserve">Video playback</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartBeginning" xml:space="preserve">Start cover videos from the beginning</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartBeginningHint" xml:space="preserve">Recommended. Starts at 0:00 and avoids the extra seek that can cause a small navigation stutter.</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartRandom" xml:space="preserve">Start cover videos at a random position</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartRandomHint" xml:space="preserve">Makes animated covers less repetitive, but each video must seek after opening and may cause a small stutter.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverSeveralHint" xml:space="preserve">Choose what happens when a game has more than one cover.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverPickSessionHint" xml:space="preserve">Keeps one cover for the whole Playnite session. On the next launch, a different cover is chosen when possible.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverPickEveryHint" xml:space="preserve">Changes the tile each time you return to the game. More dynamic, but the grid reshuffles while browsing.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverSlideshowHint" xml:space="preserve">How long each cover stays visible before the slideshow moves to the next artwork. Available only in Slideshow mode.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverAnimation" xml:space="preserve">Cover animation</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverAnimationIntro" xml:space="preserve">How one still cover gives way to the next - the selected tile in a grid, or the cover in a details view. Videos and GIFs keep their own fades.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverTransitionHint" xml:space="preserve">Transition used between still covers. Animated covers and videos keep their own playback fades. At least two covers are required.</sys:String>
    <sys:String x:Key="LOCImageRotaterLibraryIntro" xml:space="preserve">Import, optimise, convert and recover artwork stored by ImageRotater. These actions affect the plugin library itself.</sys:String>
    <sys:String x:Key="LOCImageRotaterConvert" xml:space="preserve">CONVERT</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeStoredBackgrounds" xml:space="preserve">Resize stored backgrounds</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeStoredBackgroundsHint" xml:space="preserve">Downscales existing ImageRotater backgrounds to the selected maximum resolution while preserving their aspect ratio. Preserved Playnite originals are left unchanged. Images are never stretched, cropped or upscaled. This cannot be undone.</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeStoredBackgroundsButton" xml:space="preserve">Resize stored backgrounds</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeStoredBackgroundsQuestion" xml:space="preserve">Resize stored backgrounds using the selected maximum resolution? This cannot be undone. Preserved Playnite originals will not be changed.</sys:String>
    <sys:String x:Key="LOCImageRotaterResizingStoredBackgrounds" xml:space="preserve">Resizing stored backgrounds...</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeStoredBackgroundsResult" xml:space="preserve">Resized {0} background(s) out of {1} checked.</sys:String>
    <sys:String x:Key="LOCImageRotaterAddedImagesOptimised" xml:space="preserve">Automatically optimised {0} image(s).</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseImages" xml:space="preserve">Optimise stored images</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseImagesHint" xml:space="preserve">Re-encodes suitable large opaque images as high-quality JPEG when that saves at least 10% disk space. Transparent images and files that would not become meaningfully smaller are left untouched. This rewrites stored files and cannot be undone.</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseImagesButton" xml:space="preserve">Optimise stored images</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseDownloads" xml:space="preserve">Automatically optimise new images</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseDownloadsHint" xml:space="preserve">Automatically optimises still images when they are downloaded or manually added to ImageRotater. Animated artwork, transparent images and files that would not become meaningfully smaller are left unchanged.</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeDownloadedBackgrounds" xml:space="preserve">Resize downloaded backgrounds</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeDownloadedBackgroundsHint" xml:space="preserve">Downscale large downloaded backgrounds while preserving their original aspect ratio. Images are never stretched, cropped or upscaled.</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeDownloadedBackgroundsToggle" xml:space="preserve">Resize downloaded backgrounds</sys:String>
    <sys:String x:Key="LOCImageRotaterMaximumResolution" xml:space="preserve">Maximum resolution</sys:String>
    <sys:String x:Key="LOCImageRotaterResolution1080p" xml:space="preserve">1080p</sys:String>
    <sys:String x:Key="LOCImageRotaterResolution1440p" xml:space="preserve">1440p</sys:String>
    <sys:String x:Key="LOCImageRotaterResolution4K" xml:space="preserve">4K</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertGifs" xml:space="preserve">Convert all GIFs to MP4</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertGifsHint" xml:space="preserve">Recommended if you use animated GIFs. MP4 files are usually much smaller and play more efficiently. Requires ffmpeg.</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertJpegs" xml:space="preserve">Convert all JPEGs to PNG</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertJpegsHint" xml:space="preserve">Usually unnecessary. PNG is lossless but can use much more disk space, and converting cannot restore quality already lost in a JPEG.</sys:String>
    <sys:String x:Key="LOCImageRotaterRepair" xml:space="preserve">REPAIR</sys:String>
    <sys:String x:Key="LOCImageRotaterRepairVideos" xml:space="preserve">Repair videos</sys:String>
    <sys:String x:Key="LOCImageRotaterRepairVideosHint" xml:space="preserve">Use this if downloaded videos appear as black tiles. The video container is rebuilt without re-encoding, so quality is unchanged. Requires ffmpeg.</sys:String>
    <sys:String x:Key="LOCImageRotaterRepairVideosButton" xml:space="preserve">Repair videos (fix black tiles)</sys:String>
    <sys:String x:Key="LOCImageRotaterRepairArtwork" xml:space="preserve">Repair artwork references</sys:String>
    <sys:String x:Key="LOCImageRotaterRepairArtworkHint" xml:space="preserve">Use this if a game points to ImageRotater artwork that no longer exists and appears black. The broken references are cleared; no files are deleted.</sys:String>
    <sys:String x:Key="LOCImageRotaterRecovery" xml:space="preserve">RECOVERY</sys:String>
    <sys:String x:Key="LOCImageRotaterRestoreOriginalBackgrounds" xml:space="preserve">Restore original Playnite backgrounds</sys:String>
    <sys:String x:Key="LOCImageRotaterRestoreOriginalBackgroundsHint" xml:space="preserve">Restores the background each game had before ImageRotater replaced it. This does not delete your ImageRotater artwork library; it only restores the backed-up Playnite backgrounds.</sys:String>
    <sys:String x:Key="LOCImageRotaterRestoreOriginalBackgroundsButton" xml:space="preserve">Restore original backgrounds</sys:String>
    <sys:String x:Key="LOCImageRotaterDangerZone" xml:space="preserve">DANGER ZONE</sys:String>
    <sys:String x:Key="LOCImageRotaterResetLibrary" xml:space="preserve">Reset library</sys:String>
    <sys:String x:Key="LOCImageRotaterResetLibraryHint" xml:space="preserve">Deletes every image and video ImageRotater holds for your whole library, and puts each game back to its own artwork. Your games keep the covers and backgrounds they had before the plugin touched them; anything downloaded through it is gone for good. You will be asked to confirm, and Playnite will offer to restart afterwards.</sys:String>
    <sys:String x:Key="LOCImageRotaterResetLibraryButton" xml:space="preserve">Delete all plugin artwork and restore originals</sys:String>
    <sys:String x:Key="LOCImageRotaterMigrationIntro" xml:space="preserve">Already used BackgroundChanger? You can copy its existing artwork into ImageRotater without removing anything from the old plugin.</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundChanger" xml:space="preserve">BACKGROUNDCHANGER</sys:String>
    <sys:String x:Key="LOCImageRotaterImportBackgroundChanger" xml:space="preserve">Import artwork from BackgroundChanger</sys:String>
    <sys:String x:Key="LOCImageRotaterImportBackgroundChangerHint" xml:space="preserve">Copies existing BackgroundChanger covers and backgrounds into ImageRotater, game by game. Disable BackgroundChanger after the import so both plugins do not try to control the same artwork.</sys:String>
    <sys:String x:Key="LOCImageRotaterImportWebPHint" xml:space="preserve">WebP files come across as they are. Playnite cannot show WebP natively; use the conversion tools under Library &gt; Library tools when needed.</sys:String>
    <sys:String x:Key="LOCImageRotaterSteam" xml:space="preserve">Steam</sys:String>
    <sys:String x:Key="LOCImageRotaterWebSearch" xml:space="preserve">Web search</sys:String>
    <sys:String x:Key="LOCImageRotaterYouTube" xml:space="preserve">YouTube</sys:String>
    <sys:String x:Key="LOCImageRotaterSteamSearchHelp" xml:space="preserve">Steam's own library artwork. Works for any game Steam sells, whichever store your copy came from. No key needed.</sys:String>
    <sys:String x:Key="LOCImageRotaterSgdbSearchHelp" xml:space="preserve">Curated game artwork, filtered by shape and style. Animated results need ffmpeg to preview.</sys:String>
    <sys:String x:Key="LOCImageRotaterWebSearchHelp" xml:space="preserve">Any image on the web. Quality and shape vary, so check the size before picking.</sys:String>
    <sys:String x:Key="LOCImageRotaterYouTubeSearchHelp" xml:space="preserve">Live wallpaper videos, saved as MP4. Needs yt-dlp, ffmpeg and deno - see the Tools tab in settings.</sys:String>
    <sys:String x:Key="LOCImageRotaterShapeAndSize" xml:space="preserve">Shape and size</sys:String>
    <sys:String x:Key="LOCImageRotaterStyle" xml:space="preserve">Style</sys:String>
    <sys:String x:Key="LOCImageRotaterGifConvertHint" xml:space="preserve">Smaller files, and smoother playback than an animated GIF.</sys:String>
    <sys:String x:Key="LOCImageRotaterAlsoShow" xml:space="preserve">Also show</sys:String>
