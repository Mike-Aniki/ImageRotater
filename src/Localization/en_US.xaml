    <sys:String x:Key="LOCImageRotaterDenoNotFound" xml:space="preserve">deno was not found. yt-dlp needs it to read YouTube, and without it a YouTube search returns nothing rather than reporting an error.</sys:String>
    <sys:String x:Key="LOCImageRotaterSettingsUnreadable" xml:space="preserve">Settings could not be read.</sys:String>
    <sys:String x:Key="LOCImageRotaterApiKeyLength" xml:space="preserve">The SteamGridDB API key should be {0} characters, but this one is {1}. Copy the whole key from steamgriddb.com/profile/preferences/api.</sys:String>
    <sys:String x:Key="LOCImageRotaterApiKeyChars" xml:space="preserve">The SteamGridDB API key should be letters a-f and digits only. Check for a stray space or a copied label.</sys:String>
