    <sys:String x:Key="LOCImageRotaterSetup" xml:space="preserve">Setup</sys:String>
    <sys:String x:Key="LOCImageRotaterTools" xml:space="preserve">Tools</sys:String>
    <sys:String x:Key="LOCImageRotaterGeneral" xml:space="preserve">General</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgrounds" xml:space="preserve">Backgrounds</sys:String>
    <sys:String x:Key="LOCImageRotaterAnimationFilter" xml:space="preserve">Animation</sys:String>
    <sys:String x:Key="LOCImageRotaterCovers" xml:space="preserve">Covers</sys:String>
