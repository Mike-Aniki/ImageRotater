<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCImageRotaterSetup" xml:space="preserve">Configuración</sys:String>
    <sys:String x:Key="LOCImageRotaterTools" xml:space="preserve">Herramientas</sys:String>
    <sys:String x:Key="LOCImageRotaterAdvanced" xml:space="preserve">Avanzado</sys:String>
    <sys:String x:Key="LOCImageRotaterAdvancedIntro" xml:space="preserve">Opciones de diagnóstico y depuración para solucionar problemas de ImageRotater. Normalmente no necesitas estas opciones durante el uso diario.</sys:String>
    <sys:String x:Key="LOCImageRotaterDiagnostics" xml:space="preserve">DIAGNÓSTICO</sys:String>
    <sys:String x:Key="LOCImageRotaterDebugRecommendation" xml:space="preserve">Recomendado: mantén desactivado el registro de depuración durante el uso normal. Actívalo solo mientras reproduces un problema y vuelve a desactivarlo cuando tengas el registro.</sys:String>
    <sys:String x:Key="LOCImageRotaterGeneral" xml:space="preserve">General</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgrounds" xml:space="preserve">Fondos</sys:String>
    <sys:String x:Key="LOCImageRotaterAnimationFilter" xml:space="preserve">Animación</sys:String>
    <sys:String x:Key="LOCImageRotaterCovers" xml:space="preserve">Carátulas</sys:String>
    <sys:String x:Key="LOCImageRotaterLibrary" xml:space="preserve">Biblioteca</sys:String>
    <sys:String x:Key="LOCImageRotaterMaintenance" xml:space="preserve">Herramientas de biblioteca</sys:String>
    <sys:String x:Key="LOCImageRotaterMigration" xml:space="preserve">Migración</sys:String>
    <sys:String x:Key="LOCImageRotaterSetupIntro" xml:space="preserve">Herramientas opcionales para ilustraciones animadas y vídeo. ImageRotater funciona sin ellas; configura solo las funciones que quieras usar.</sys:String>
    <sys:String x:Key="LOCImageRotaterSteamGridDB" xml:space="preserve">SteamGridDB</sys:String>
    <sys:String x:Key="LOCImageRotaterSteamGridDBHelp" xml:space="preserve">Opcional. Añade ilustraciones de SteamGridDB a la búsqueda en línea. Crea una clave API gratuita en SteamGridDB y pégala abajo.</sys:String>
    <sys:String x:Key="LOCImageRotaterApiKey" xml:space="preserve">Clave API</sys:String>
    <sys:String x:Key="LOCImageRotaterApiKeyStorage" xml:space="preserve">La clave se guarda como texto sin cifrar en la configuración de Playnite. Solo permite acceder a las ilustraciones públicas de SteamGridDB y puede regenerarse en cualquier momento.</sys:String>
    <sys:String x:Key="LOCImageRotaterFfmpeg" xml:space="preserve">ffmpeg</sys:String>
    <sys:String x:Key="LOCImageRotaterFfmpegHelp" xml:space="preserve">Recomendado para ilustraciones animadas. Convierte GIF en archivos MP4 más pequeños y también es necesario para descargar y reparar vídeos.</sys:String>
    <sys:String x:Key="LOCImageRotaterYtDlp" xml:space="preserve">yt-dlp</sys:String>
    <sys:String x:Key="LOCImageRotaterYtDlpHelp" xml:space="preserve">Opcional. Permite descargar vídeos de YouTube y otros sitios compatibles. Requiere ffmpeg y un entorno de ejecución de JavaScript como Deno.</sys:String>
    <sys:String x:Key="LOCImageRotaterDeno" xml:space="preserve">deno</sys:String>
    <sys:String x:Key="LOCImageRotaterDenoHelp" xml:space="preserve">Solo es necesario para YouTube mediante yt-dlp. Selecciona deno.exe o colócalo junto a yt-dlp.exe para que pueda detectarse automáticamente.</sys:String>
    <sys:String x:Key="LOCImageRotaterCheckingTools" xml:space="preserve">Comprobando herramientas...</sys:String>
    <sys:String x:Key="LOCImageRotaterToolPathHint" xml:space="preserve">Puedes dejar la ruta vacía si la herramienta ya está disponible en el PATH de Windows. De lo contrario, busca el ejecutable.</sys:String>
    <sys:String x:Key="LOCImageRotaterBrowse" xml:space="preserve">Examinar…</sys:String>
    <sys:String x:Key="LOCImageRotaterGeneralIntro" xml:space="preserve">Configura aquí lo esencial. Elige qué gestiona ImageRotater y después ajusta los fondos y las carátulas en sus páginas dedicadas.</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeIntegration" xml:space="preserve">Integración con el tema</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeIntegrationHint" xml:space="preserve">Usa esta opción si tu tema de Playnite es compatible con ImageRotater. Se recomienda esta opción porque ofrece el mejor rendimiento, admite ilustraciones animadas y mantiene intactas las carátulas y los fondos nativos de Playnite.</sys:String>
    <sys:String x:Key="LOCImageRotaterCompatibilityModeHint" xml:space="preserve">Si tu tema no es compatible, desactiva esta opción. ImageRotater funcionará entonces con casi cualquier tema actualizando directamente las ilustraciones nativas de Playnite. Esto puede provocar más actualizaciones de la base de datos y reducir el rendimiento cuando otros plugins reaccionan a esos cambios.</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeIntegrationTooltip" xml:space="preserve">Usar el renderizado integrado con el tema. Desactívalo solo si el tema activo no es compatible con ImageRotater.</sys:String>
    <sys:String x:Key="LOCImageRotaterActiveThemeSupport" xml:space="preserve">Compatibilidad de los temas activos</sys:String>
    <sys:String x:Key="LOCImageRotaterDesktopThemeLabel" xml:space="preserve">Escritorio:</sys:String>
    <sys:String x:Key="LOCImageRotaterFullscreenThemeLabel" xml:space="preserve">Pantalla completa:</sys:String>
    <sys:String x:Key="LOCImageRotaterCheckingThemeSupport" xml:space="preserve">Comprobando compatibilidad del tema...</sys:String>
    <sys:String x:Key="LOCImageRotaterUnknownTheme" xml:space="preserve">Tema desconocido</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeSupportFull" xml:space="preserve">{0} — Compatible (Fondo + Carátula)</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeSupportBackgroundOnly" xml:space="preserve">{0} — Compatibilidad parcial (Solo fondo)</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeSupportCoverOnly" xml:space="preserve">{0} — Compatibilidad parcial (Solo carátula)</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeSupportNone" xml:space="preserve">{0} — No compatible</sys:String>
    <sys:String x:Key="LOCImageRotaterThemeSupportUnknown" xml:space="preserve">{0} — No se pudieron comprobar los archivos del tema</sys:String>
    <sys:String x:Key="LOCImageRotaterMasterDescription" xml:space="preserve">Activa o desactiva el plugin desde un único lugar. Al desactivarlo se pausa la rotación y el contenido animado sin eliminar tus ilustraciones ni cambiar la configuración.</sys:String>
    <sys:String x:Key="LOCImageRotaterChooseContent" xml:space="preserve">ELIGE QUÉ GESTIONA IMAGEROTATER</sys:String>
    <sys:String x:Key="LOCImageRotaterChooseContentHint" xml:space="preserve">Activa cada función de forma independiente. Puedes configurar el comportamiento de cada una desde su propia página.</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundCardTitle" xml:space="preserve">Fondos</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundCardText" xml:space="preserve">Rota los fondos de los juegos y controla el método de selección, las presentaciones, la posición inicial de los vídeos y las transiciones.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverCardTitle" xml:space="preserve">Carátulas</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverCardText" xml:space="preserve">Rota las carátulas de los juegos y controla el método de selección, las presentaciones, el rendimiento de las animaciones y las transiciones.</sys:String>
    <sys:String x:Key="LOCImageRotaterConfigureBackgrounds" xml:space="preserve">Configurar fondos</sys:String>
    <sys:String x:Key="LOCImageRotaterConfigureCovers" xml:space="preserve">Configurar carátulas</sys:String>
    <sys:String x:Key="LOCImageRotaterAdvancedAndSupport" xml:space="preserve">AVANZADO Y SOPORTE</sys:String>
    <sys:String x:Key="LOCImageRotaterRotation" xml:space="preserve">ROTACIÓN</sys:String>
    <sys:String x:Key="LOCImageRotaterTabRotation" xml:space="preserve">Rotación</sys:String>
    <sys:String x:Key="LOCImageRotaterTabDisplay" xml:space="preserve">Visualización</sys:String>
    <sys:String x:Key="LOCImageRotaterTabAnimation" xml:space="preserve">Animación</sys:String>
    <sys:String x:Key="LOCImageRotaterTabOnlineSources" xml:space="preserve">Fuentes en línea</sys:String>
    <sys:String x:Key="LOCImageRotaterTabVideoTools" xml:space="preserve">Herramientas de vídeo</sys:String>
    <sys:String x:Key="LOCImageRotaterTabPerformance" xml:space="preserve">Rendimiento</sys:String>
    <sys:String x:Key="LOCImageRotaterTabDebug" xml:space="preserve">Depuración</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableRotation" xml:space="preserve">ImageRotater</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableRotationHint" xml:space="preserve">Interruptor principal. Al desactivarlo se detiene toda la rotación y el contenido animado sin borrar archivos ni ajustes.</sys:String>
    <sys:String x:Key="LOCImageRotaterTroubleshooting" xml:space="preserve">SOLUCIÓN DE PROBLEMAS</sys:String>
    <sys:String x:Key="LOCImageRotaterExpertTools" xml:space="preserve">HERRAMIENTAS AVANZADAS</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableDebug" xml:space="preserve">Activar registro de depuración</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableDebugHint" xml:space="preserve">Crea un ImageRotater.log detallado para solucionar problemas. Déjalo desactivado salvo que estés diagnosticando un problema.</sys:String>
    <sys:String x:Key="LOCImageRotaterOpenDebugLogFolder" xml:space="preserve">Abrir la carpeta del registro de depuración</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundIntro" xml:space="preserve">Controla cuándo cambian los fondos, cómo se tratan las formas de imagen poco habituales y qué transición se utiliza.</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableBackgrounds" xml:space="preserve">Activar rotación de fondos</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableBackgroundsHint" xml:space="preserve">Solo controla los fondos. La configuración de carátulas no se ve afectada.</sys:String>
    <sys:String x:Key="LOCImageRotaterShape" xml:space="preserve">FORMA</sys:String>
    <sys:String x:Key="LOCImageRotaterLetterbox" xml:space="preserve">Ajustar formatos de fondo poco habituales en lugar de recortarlos</sys:String>
    <sys:String x:Key="LOCImageRotaterLetterboxHint" xml:space="preserve">Útil para imágenes ultrapanorámicas, cuadradas o tipo banner. La imagen original se conserva completa y se coloca sobre un relleno desenfocado para adaptarse a la pantalla. Este procesamiento adicional puede consumir más recursos al cambiar de fondo, así que déjalo desactivado salvo que lo necesites.</sys:String>
    <sys:String x:Key="LOCImageRotaterLevelBackgrounds" xml:space="preserve">Mantener un desenfoque de fondo visualmente uniforme</sys:String>
    <sys:String x:Key="LOCImageRotaterLevelBackgroundsHint" xml:space="preserve">Normaliza el ancho del fondo publicado para que Playnite aplique una cantidad de desenfoque similar al cambiar entre imágenes de distintas resoluciones. Los archivos originales no se modifican. Este procesamiento adicional puede consumir más recursos al cambiar de fondo, así que déjalo desactivado salvo que lo necesites.</sys:String>
    <sys:String x:Key="LOCImageRotaterWhenSeveral" xml:space="preserve">CUANDO UN JUEGO TIENE VARIAS</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundSeveralHint" xml:space="preserve">Elige qué ocurre cuando un juego tiene más de un fondo. Los juegos con un solo fondo no cambian.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickSession" xml:space="preserve">Sesión</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundPickSessionHint" xml:space="preserve">Mantiene un fondo durante toda la sesión de Playnite. En el siguiente inicio se elige otro fondo cuando sea posible.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickEverySelection" xml:space="preserve">Elegir una imagen nueva cada vez que selecciono el juego</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundPickEveryHint" xml:space="preserve">Cambia el fondo cada vez que vuelves al juego.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickFixed" xml:space="preserve">Ilustración fija</sys:String>
    <sys:String x:Key="LOCImageRotaterPickFixedHint" xml:space="preserve">Usa siempre la ilustración marcada como fija en el Artwork Manager. Si no hay ninguna seleccionada, se usa la primera según el orden del manager.</sys:String>
    <sys:String x:Key="LOCImageRotaterPickSlideshow" xml:space="preserve">Presentación</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundPickSlideshowHint" xml:space="preserve">Recorre automáticamente los fondos del juego mientras permaneces en él.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverPickSlideshowHint" xml:space="preserve">Recorre automáticamente las carátulas del juego seleccionado mientras permaneces en él.</sys:String>
    <sys:String x:Key="LOCImageRotaterSlideshowInterval" xml:space="preserve">Intervalo de presentación</sys:String>
    <sys:String x:Key="LOCImageRotaterSlideshow" xml:space="preserve">PRESENTACIÓN</sys:String>
    <sys:String x:Key="LOCImageRotaterChangeEvery" xml:space="preserve">Cambiar cada</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundSlideshowHint" xml:space="preserve">Tiempo que permanece visible cada fondo antes de pasar a la siguiente ilustración. Solo disponible en modo Presentación.</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundAnimation" xml:space="preserve">Animación del fondo</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundAnimationIntro" xml:space="preserve">Define cómo un fondo estático da paso al siguiente. Los vídeos y GIF se reproducen normalmente y mantienen sus propios fundidos.</sys:String>
    <sys:String x:Key="LOCImageRotaterTransition" xml:space="preserve">TRANSICIÓN</sys:String>
    <sys:String x:Key="LOCImageRotaterBackgroundTransitionHint" xml:space="preserve">Transición utilizada entre fondos estáticos. El fundido cruzado es la opción predeterminada más suave. Se necesitan al menos dos fondos para que haya transición.</sys:String>
    <sys:String x:Key="LOCImageRotaterCrossfade" xml:space="preserve">Fundido cruzado</sys:String>
    <sys:String x:Key="LOCImageRotaterFadeBlack" xml:space="preserve">Fundido a negro</sys:String>
    <sys:String x:Key="LOCImageRotaterFadeWhite" xml:space="preserve">Fundido a blanco</sys:String>
    <sys:String x:Key="LOCImageRotaterSlideRight" xml:space="preserve">Deslizamiento desde la derecha</sys:String>
    <sys:String x:Key="LOCImageRotaterSideReveal" xml:space="preserve">Revelado lateral</sys:String>
    <sys:String x:Key="LOCImageRotaterDiagonalReveal" xml:space="preserve">Revelado diagonal</sys:String>
    <sys:String x:Key="LOCImageRotaterDepthShift" xml:space="preserve">Cinemática</sys:String>
    <sys:String x:Key="LOCImageRotaterMosaic" xml:space="preserve">Mosaic</sys:String>
    <sys:String x:Key="LOCImageRotaterPixelate" xml:space="preserve">Pixelado</sys:String>
    <sys:String x:Key="LOCImageRotaterZoom" xml:space="preserve">Alejar zoom</sys:String>
    <sys:String x:Key="LOCImageRotaterFocus" xml:space="preserve">Enfoque</sys:String>
    <sys:String x:Key="LOCImageRotaterCut" xml:space="preserve">Corte (sin animación)</sys:String>
    <sys:String x:Key="LOCImageRotaterCrossfadeHint" xml:space="preserve">Mezcla suavemente la imagen anterior con la nueva.</sys:String>
    <sys:String x:Key="LOCImageRotaterFadeBlackHint" xml:space="preserve">Desvanece la imagen anterior a negro antes de mostrar la siguiente.</sys:String>
    <sys:String x:Key="LOCImageRotaterFadeWhiteHint" xml:space="preserve">Desvanece la imagen anterior a blanco antes de mostrar la siguiente.</sys:String>
    <sys:String x:Key="LOCImageRotaterSlideRightHint" xml:space="preserve">Desliza la nueva imagen desde la derecha.</sys:String>
    <sys:String x:Key="LOCImageRotaterSideRevealHint" xml:space="preserve">Revela la nueva imagen desde un lado con un borde suave y progresivo.</sys:String>
    <sys:String x:Key="LOCImageRotaterDiagonalRevealHint" xml:space="preserve">Revela la nueva imagen en diagonal con un borde suave y progresivo.</sys:String>
    <sys:String x:Key="LOCImageRotaterDepthShiftHint" xml:space="preserve">La imagen anterior retrocede y se suaviza mientras la nueva avanza al frente y se vuelve nítida.</sys:String>
    <sys:String x:Key="LOCImageRotaterMosaicHint" xml:space="preserve">Revela la nueva imagen mediante bloques de mosaico animados.</sys:String>
    <sys:String x:Key="LOCImageRotaterPixelateHint" xml:space="preserve">Pixeliza la imagen con un estilo retro de 16 bits antes de revelar la siguiente.</sys:String>
    <sys:String x:Key="LOCImageRotaterZoomHint" xml:space="preserve">Empieza ligeramente ampliada y vuelve suavemente a su tamaño normal.</sys:String>
    <sys:String x:Key="LOCImageRotaterFocusHint" xml:space="preserve">La imagen anterior se desenfoca mientras la nueva aparece borrosa y se vuelve nítida.</sys:String>
    <sys:String x:Key="LOCImageRotaterCutHint" xml:space="preserve">Cambia al instante a la siguiente imagen, sin animación.</sys:String>

    <sys:String x:Key="LOCImageRotaterCoverIntro" xml:space="preserve">Controla cómo rotan las carátulas en las vistas de cuadrícula y detalles, incluidas las carátulas animadas y el comportamiento de los vídeos.</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableCovers" xml:space="preserve">Activar rotación de carátulas</sys:String>
    <sys:String x:Key="LOCImageRotaterEnableCoversHint" xml:space="preserve">Solo controla las carátulas. La configuración de fondos no se ve afectada.</sys:String>
    <sys:String x:Key="LOCImageRotaterAnimateUnfocused" xml:space="preserve">Reproducir carátulas animadas en todas las fichas visibles, no solo en la seleccionada</sys:String>
    <sys:String x:Key="LOCImageRotaterAnimateUnfocusedHint" xml:space="preserve">Reproduce las carátulas animadas de todos los juegos visibles en la cuadrícula, en lugar de animar solo la del juego seleccionado. Esto hace que la biblioteca se vea más viva, pero puede usar más recursos en equipos menos potentes.</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStart" xml:space="preserve">Reproducción de vídeo</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartBeginning" xml:space="preserve">Iniciar los vídeos de carátula desde el principio</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartBeginningHint" xml:space="preserve">Recomendado. Empieza en 0:00 y evita la búsqueda adicional que puede causar un pequeño tirón al navegar.</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartRandom" xml:space="preserve">Iniciar los vídeos de carátula en una posición aleatoria</sys:String>
    <sys:String x:Key="LOCImageRotaterVideoStartRandomHint" xml:space="preserve">Hace que las carátulas animadas sean menos repetitivas, pero cada vídeo debe buscar una posición después de abrirse y puede provocar un pequeño tirón.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverSeveralHint" xml:space="preserve">Elige qué ocurre cuando un juego tiene más de una carátula.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverPickSessionHint" xml:space="preserve">Mantiene una carátula durante toda la sesión de Playnite. En el siguiente inicio se elige otra cuando sea posible.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverPickEveryHint" xml:space="preserve">Cambia la ficha cada vez que vuelves al juego. Es más dinámico, pero la cuadrícula cambia mientras navegas.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverSlideshowHint" xml:space="preserve">Tiempo que permanece visible cada carátula antes de pasar a la siguiente ilustración. Solo disponible en modo Presentación.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverAnimation" xml:space="preserve">Animación de carátula</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverAnimationIntro" xml:space="preserve">Define cómo una carátula estática da paso a la siguiente: la ficha seleccionada en una cuadrícula o la carátula en una vista de detalles. Los vídeos y GIF mantienen sus propios fundidos.</sys:String>
    <sys:String x:Key="LOCImageRotaterCoverTransitionHint" xml:space="preserve">Transición utilizada entre carátulas estáticas. Las carátulas animadas y los vídeos mantienen sus propios fundidos de reproducción. Se requieren al menos dos carátulas.</sys:String>
    <sys:String x:Key="LOCImageRotaterLibraryIntro" xml:space="preserve">Importa, optimiza, convierte y recupera ilustraciones almacenadas por ImageRotater. Estas acciones afectan directamente a la biblioteca del plugin.</sys:String>
    <sys:String x:Key="LOCImageRotaterConvert" xml:space="preserve">CONVERTIR</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeStoredBackgrounds" xml:space="preserve">Redimensionar fondos almacenados</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeStoredBackgroundsHint" xml:space="preserve">Reduce los fondos ya almacenados por ImageRotater a la resolución máxima seleccionada manteniendo su relación de aspecto. Los originales de Playnite conservados no se modifican. Las imágenes nunca se estiran, recortan ni amplían. Esta acción no se puede deshacer.</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeStoredBackgroundsButton" xml:space="preserve">Redimensionar fondos almacenados</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeStoredBackgroundsQuestion" xml:space="preserve">¿Redimensionar los fondos almacenados usando la resolución máxima seleccionada? Esta acción no se puede deshacer. Los originales de Playnite conservados no se modificarán.</sys:String>
    <sys:String x:Key="LOCImageRotaterResizingStoredBackgrounds" xml:space="preserve">Redimensionando fondos almacenados...</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeStoredBackgroundsResult" xml:space="preserve">Se redimensionaron {0} fondo(s) de {1} comprobado(s).</sys:String>
    <sys:String x:Key="LOCImageRotaterAddedImagesOptimised" xml:space="preserve">Se optimizaron automáticamente {0} imagen(es).</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseImages" xml:space="preserve">Optimizar imágenes almacenadas</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseImagesHint" xml:space="preserve">Vuelve a codificar imágenes opacas grandes y adecuadas como JPEG de alta calidad cuando eso ahorra al menos un 10 % de espacio en disco. Las imágenes con transparencia y los archivos que no se reducirían de forma significativa no se modifican. Esto reescribe los archivos almacenados y no se puede deshacer.</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseImagesButton" xml:space="preserve">Optimizar imágenes almacenadas</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseDownloads" xml:space="preserve">Optimizar automáticamente las imágenes nuevas</sys:String>
    <sys:String x:Key="LOCImageRotaterOptimiseDownloadsHint" xml:space="preserve">Optimiza automáticamente las imágenes estáticas cuando se descargan o se añaden manualmente a ImageRotater. Las imágenes animadas, transparentes y las que no se reducirían de forma significativa permanecen sin cambios.</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeDownloadedBackgrounds" xml:space="preserve">Redimensionar fondos descargados</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeDownloadedBackgroundsHint" xml:space="preserve">Reduce los fondos descargados demasiado grandes manteniendo su relación de aspecto original. Las imágenes nunca se estiran, recortan ni amplían.</sys:String>
    <sys:String x:Key="LOCImageRotaterResizeDownloadedBackgroundsToggle" xml:space="preserve">Redimensionar fondos descargados</sys:String>
    <sys:String x:Key="LOCImageRotaterMaximumResolution" xml:space="preserve">Resolución máxima</sys:String>
    <sys:String x:Key="LOCImageRotaterResolution1080p" xml:space="preserve">1080p</sys:String>
    <sys:String x:Key="LOCImageRotaterResolution1440p" xml:space="preserve">1440p</sys:String>
    <sys:String x:Key="LOCImageRotaterResolution4K" xml:space="preserve">4K</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertGifs" xml:space="preserve">Convertir todos los GIF a MP4</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertGifsHint" xml:space="preserve">Recomendado si usas GIF animados. Los archivos MP4 suelen ser mucho más pequeños y se reproducen de forma más eficiente. Requiere ffmpeg.</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertJpegs" xml:space="preserve">Convertir todos los JPEG a PNG</sys:String>
    <sys:String x:Key="LOCImageRotaterConvertJpegsHint" xml:space="preserve">Normalmente no es necesario. PNG no tiene pérdida, pero puede ocupar mucho más espacio en disco, y la conversión no puede recuperar la calidad ya perdida en un JPEG.</sys:String>
    <sys:String x:Key="LOCImageRotaterRepair" xml:space="preserve">REPARAR</sys:String>
    <sys:String x:Key="LOCImageRotaterRepairVideos" xml:space="preserve">Reparar vídeos</sys:String>
