<c:PluginUserControl x:Class="ImageRotater.Controls.BackgroundImageControl"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:c="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK">
    <Grid x:Name="RootGrid" ClipToBounds="True" IsHitTestVisible="False">

        <!-- Double-buffered slots keep the outgoing media visible until the incoming media is ready. -->
        <Grid x:Name="SlotA" Visibility="Collapsed" Opacity="0">
            <Image x:Name="SlotAImage"
                   Visibility="Collapsed"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <MediaElement x:Name="SlotAVideo"
                          Visibility="Collapsed"
                          Stretch="UniformToFill"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          IsMuted="True"
                          ScrubbingEnabled="False"
                          Loaded="SlotVideo_Loaded"
                          MediaOpened="SlotVideo_MediaOpened"
                          MediaEnded="SlotVideo_MediaEnded"
                          MediaFailed="SlotVideo_MediaFailed"/>
        </Grid>

        <Grid x:Name="SlotB" Visibility="Collapsed" Opacity="0">
            <Image x:Name="SlotBImage"
                   Visibility="Collapsed"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <MediaElement x:Name="SlotBVideo"
                          Visibility="Collapsed"
                          Stretch="UniformToFill"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          IsMuted="True"
                          ScrubbingEnabled="False"
                          Loaded="SlotVideo_Loaded"
                          MediaOpened="SlotVideo_MediaOpened"
                          MediaEnded="SlotVideo_MediaEnded"
                          MediaFailed="SlotVideo_MediaFailed"/>
        </Grid>

        <!-- Used only for the FadeThroughBlack / FadeThroughWhite settings. -->
        <Border x:Name="FlashOverlay"
                Visibility="Collapsed"
                Opacity="0"/>

        <!-- A corrupt/missing chosen file is a real error, unlike a game that
             simply has no ImageRotater artwork. -->
        <Viewbox x:Name="MissingImagePlaceholder"
                 Visibility="Collapsed"
                 Tag="{DynamicResource TextBrush}"
                 Width="96" Height="96"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Opacity="0.28">
            <Canvas Width="24" Height="24">
                <Path Data="M3,3 H21 V21 H3 Z"
                      Stroke="{Binding Tag, ElementName=MissingImagePlaceholder, TargetNullValue=#FFCCCCCC, FallbackValue=#FFCCCCCC}"
                      StrokeThickness="1.2"
                      Fill="Transparent"/>
                <Path Data="M9.2,9.1 C9.2,7.7 10.4,6.8 12,6.8 C13.6,6.8 14.8,7.7 14.8,9.1 C14.8,10.6 13.4,10.9 12.6,11.8 C12.2,12.3 12.1,12.8 12.1,13.6"
                      Stroke="{Binding Tag, ElementName=MissingImagePlaceholder, TargetNullValue=#FFCCCCCC, FallbackValue=#FFCCCCCC}"
                      StrokeThickness="1.4"
                      Fill="Transparent"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="11.35" Canvas.Top="15.2"
                         Width="1.4" Height="1.4"
                         Fill="{Binding Tag, ElementName=MissingImagePlaceholder, TargetNullValue=#FFCCCCCC, FallbackValue=#FFCCCCCC}"/>
            </Canvas>
        </Viewbox>

    </Grid>
</c:PluginUserControl>
