<UserControl x:Class="ImageRotater.Controls.ArtworkPacksView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ImageRotater;component/Controls/ArtworkManagerResources.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <Style TargetType="Button" BasedOn="{StaticResource ManagerPrimaryButtonStyle}"/>
   <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
   <Style x:Key="SlotButton" TargetType="Button" BasedOn="{StaticResource ManagerPrimaryButtonStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="10"/>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock x:Name="GameNameText" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{DynamicResource LOCImageRotaterPackManagerIntro}" Foreground="{StaticResource ManagerMutedBrush}" Margin="0,5,20,0" TextWrapping="Wrap"/>
   </StackPanel>
   <Button x:Name="NewPackButton" Grid.Column="1" Content="{DynamicResource LOCImageRotaterPacksNew}" Click="New_Click" VerticalAlignment="Center"/>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource ManagerCardStyle}" Padding="12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{DynamicResource LOCImageRotaterPackMyPacks}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <ListView x:Name="PackList" Grid.Row="1" Style="{StaticResource ArtworkListViewStyle}" ItemContainerStyle="{StaticResource ArtworkListItemStyle}" SelectionChanged="PackList_SelectionChanged">
      <ListView.ItemTemplate><DataTemplate>
       <StackPanel>
        <Border Background="#10181E" Height="95" CornerRadius="6" ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Border>
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,8,2,0"/>
        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource ManagerMutedBrush}" TextWrapping="Wrap" Margin="2,4,2,0"/>
       </StackPanel>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
     <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="UpPackButton" Content="{DynamicResource LOCImageRotaterPackMoveUp}" Click="Up_Click" Margin="0,0,4,0" Padding="6"/>
      <Button x:Name="DownPackButton" Grid.Column="1" Content="{DynamicResource LOCImageRotaterPackMoveDown}" Click="Down_Click" Margin="4,0,0,0" Padding="6"/>
     </Grid>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource ManagerCardStyle}" Padding="18">
    <Grid>
     <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
      <TextBlock Text="{DynamicResource LOCImageRotaterPackEmptyTitle}" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/>
      <TextBlock Text="{DynamicResource LOCImageRotaterPackEmptyHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource ManagerMutedBrush}" Margin="0,12,0,20"/>
      <Button Content="{DynamicResource LOCImageRotaterPackCreateFirst}" Click="New_Click" HorizontalAlignment="Center"/>
     </StackPanel>
     <ScrollViewer x:Name="Editor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="{DynamicResource LOCImageRotaterPacksName}" Foreground="{StaticResource ManagerMutedBrush}" Margin="0,0,0,6"/>
       <TextBox x:Name="NameBox" TextChanged="Name_Changed" FontSize="18" Padding="10,7"
                Background="#D9172127" Foreground="{DynamicResource TextBrush}"
                BorderBrush="{StaticResource ManagerBorderBrush}" BorderThickness="1"
                CaretBrush="{StaticResource ManagerAccentBrush}"/>
       <Border Background="#10181E" BorderBrush="{StaticResource ManagerBorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,16,0,0" ClipToBounds="True">
        <Grid Height="260" x:Name="PreviewPanel">
         <Image x:Name="BackgroundPreview" Stretch="UniformToFill"/>
         <Border Background="#45000000"/>
         <Image x:Name="CoverPreview" Width="108" Height="165" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20" Stretch="Uniform"/>
         <Image x:Name="LogoPreview" Width="210" Height="85" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Stretch="Uniform"/>
        </Grid>
       </Border>
       <TextBlock Text="{DynamicResource LOCImageRotaterPacksPreviewHint}" Foreground="{StaticResource ManagerMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,14"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="CoverSlot" Style="{StaticResource SlotButton}" Tag="Cover" Click="ChooseArtwork_Click">
         <StackPanel HorizontalAlignment="Stretch"><TextBlock x:Name="CoverSlotTitle" Text="{DynamicResource LOCImageRotaterPacksCover}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Stretch"/><Image x:Name="CoverSlotPreview" Height="65" Stretch="Uniform" Margin="0,8,0,8"/><TextBlock x:Name="CoverSlotText" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Stretch" FontSize="11" Foreground="{StaticResource ManagerMutedBrush}"/><TextBlock x:Name="CoverSlotChoose" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{DynamicResource LOCImageRotaterPackChoose}" Foreground="{StaticResource ManagerAccentBrush}" Margin="0,8,0,0"/></StackPanel>
        </Button>
        <Button x:Name="BackgroundSlot" Grid.Column="2" Style="{StaticResource SlotButton}" Tag="Background" Click="ChooseArtwork_Click">
         <StackPanel HorizontalAlignment="Stretch"><TextBlock x:Name="BackgroundSlotTitle" Text="{DynamicResource LOCImageRotaterPacksBackground}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Stretch"/><Image x:Name="BackgroundSlotPreview" Height="65" Stretch="Uniform" Margin="0,8,0,8"/><TextBlock x:Name="BackgroundSlotText" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Stretch" FontSize="11" Foreground="{StaticResource ManagerMutedBrush}"/><TextBlock x:Name="BackgroundSlotChoose" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{DynamicResource LOCImageRotaterPackChoose}" Foreground="{StaticResource ManagerAccentBrush}" Margin="0,8,0,0"/></StackPanel>
        </Button>
        <Button x:Name="LogoSlot" Grid.Column="4" Style="{StaticResource SlotButton}" Tag="Logo" Click="ChooseArtwork_Click">
         <StackPanel HorizontalAlignment="Stretch"><TextBlock x:Name="LogoSlotTitle" Text="{DynamicResource LOCImageRotaterPacksLogo}" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Stretch"/><Image x:Name="LogoSlotPreview" Height="65" Stretch="Uniform" Margin="0,8,0,8"/><TextBlock x:Name="LogoSlotText" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Stretch" FontSize="11" Foreground="{StaticResource ManagerMutedBrush}"/><TextBlock x:Name="LogoSlotChoose" TextAlignment="Center" HorizontalAlignment="Stretch" Text="{DynamicResource LOCImageRotaterPackChoose}" Foreground="{StaticResource ManagerAccentBrush}" Margin="0,8,0,0"/></StackPanel>
        </Button>
       </Grid>
       <TextBlock x:Name="WarningText" Foreground="{StaticResource ManagerGoldBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
       <WrapPanel Margin="0,16,0,0">
        <CheckBox x:Name="IncludedBox" Content="{DynamicResource LOCImageRotaterPackInclude}" Checked="Included_Changed" Unchecked="Included_Changed" VerticalAlignment="Center" Margin="0,0,16,8"/>
        <Button x:Name="PinPackButton" Content="{DynamicResource LOCImageRotaterPackPin}" Click="Pin_Click" Padding="10,6" Margin="0,0,8,8"/>
        <Button x:Name="DeletePackButton" Content="{DynamicResource LOCImageRotaterPacksDelete}" Click="Delete_Click" Foreground="{StaticResource ManagerDangerBrush}" Padding="10,6" Margin="0,0,0,8"/>
       </WrapPanel>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,14,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource ManagerMutedBrush}" Margin="0,0,15,0"/>
   <Button x:Name="SavePacksButton" Grid.Column="1" Content="{DynamicResource LOCImageRotaterPacksSave}" Click="Save_Click" BorderBrush="{StaticResource ManagerAccentBrush}" Margin="0,0,10,0"/>
   <Button Grid.Column="2" Content="{DynamicResource LOCImageRotaterPackClose}" Click="Close_Click"/>
  </Grid>
  <Border x:Name="GalleryOverlay" Grid.RowSpan="3" Background="#FA111B22" BorderBrush="{StaticResource ManagerAccentBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Visibility="Collapsed">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock x:Name="GalleryTitle" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource LOCImageRotaterPackGalleryHint}" Foreground="{StaticResource ManagerMutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    <ListView x:Name="ArtworkChoices" Grid.Row="1" Style="{StaticResource ArtworkListViewStyle}" ItemContainerStyle="{StaticResource ArtworkListItemStyle}" MouseDoubleClick="ArtworkChoices_DoubleClick">
     <ListView.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
     <ListView.ItemTemplate><DataTemplate>
      <StackPanel Width="180" Margin="3"><Border Height="125" Background="#1B2B34" CornerRadius="6"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,9,0,3" ToolTip="{Binding Label}"/></StackPanel>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Content="{DynamicResource LOCImageRotaterPackAddFiles}" Click="AddFiles_Click" HorizontalAlignment="Left"/>
     <Button x:Name="ChooseArtworkButton" Grid.Column="1" Content="{DynamicResource LOCImageRotaterPackUseArtwork}" Click="UseArtwork_Click" Margin="0,0,10,0" BorderBrush="{StaticResource ManagerAccentBrush}"/>
     <Button Grid.Column="2" Content="{DynamicResource LOCImageRotaterPackCancel}" Click="CancelGallery_Click"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</UserControl>
