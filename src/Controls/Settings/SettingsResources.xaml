<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Hybrid ImageRotater / Playnite settings presentation.

      ImageRotater keeps its own navigation, glass cards, cyan accent and compact control
      language. The host window itself is left visible so the active Playnite Desktop theme
      still frames the page, and top-level headings use Playnite's text resources.

      Controls remain explicitly keyed so a Desktop theme cannot accidentally replace their
      templates or sizing. This keeps the page recognisably ImageRotater while avoiding the
      feeling of a completely separate application inside Playnite.
    -->

    <!-- Palette. The same construction as UniPlaySong's page - ground, surface, stroke,
         accent, two text weights - but its own colours: a deep indigo ground with a lavender
         accent, where UniPlaySong is slate and cyan and SuperScroll slate and mint. The three
         share a language, not a coat of paint. Warn and danger stay amber and red, because
         those mean the same thing everywhere. -->
    <SolidColorBrush x:Key="IrGround"     Color="#E612181E"/>
    <SolidColorBrush x:Key="IrSurface"    Color="#E61A2026"/>
    <SolidColorBrush x:Key="IrSurfaceHi"  Color="#E6202A31"/>
    <SolidColorBrush x:Key="IrStroke"     Color="#2F3D45"/>
    <SolidColorBrush x:Key="IrStrokeHi"   Color="#42545E"/>
    <SolidColorBrush x:Key="IrAccent"     Color="#32CFE5"/>
    <SolidColorBrush x:Key="IrText"       Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="IrTextMuted"  Color="#B9C3C9"/>
    <SolidColorBrush x:Key="IrWarn"       Color="#D9A441"/>
    <SolidColorBrush x:Key="IrDanger"     Color="#E07A6E"/>

    <!-- The page ground is a slow diagonal rather than a flat fill: a flat ground gives a
         translucent card nothing to sit on. The range is tiny on purpose. -->
    <LinearGradientBrush x:Key="IrGroundGlass" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#181F26"/>
        <GradientStop Offset="0.55" Color="#111920"/>
        <GradientStop Offset="1" Color="#0B1218"/>
    </LinearGradientBrush>

    <!-- ============================== Page shell ============================== -->

    <!-- Padding sits here rather than on the inner panel so the ground fills the whole page
         instead of leaving a theme-coloured gutter round the edge. -->
    <Style x:Key="IrPage" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="26,22,28,28"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource IrText}"/>
    </Style>

    <Style x:Key="IrPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="IrPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}"/>
        
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Section heading with a left accent bar, so groups of settings read as bands rather than
         another line of bold text. Title text goes in as UPPERCASE. -->
    <Style x:Key="IrSectionBar" TargetType="Border">
        <Setter Property="Background" Value="#10101820"/>
        <Setter Property="BorderBrush" Value="#2A32CFE5"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="10,10,0,0"/>
        <Setter Property="Padding" Value="12,10,12,11"/>
        <Setter Property="Margin" Value="0,10,0,8"/>
    </Style>

    <Style x:Key="IrSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FFE6B86A"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ============================== Type ============================== -->

    <!-- Indent lines the hint up with the toggle's LABEL, not its switch: 24 track + 8 gap. -->
    <Style x:Key="IrHint" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource IrTextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="42,3,0,12"/>
    </Style>

    <Style x:Key="IrHintIndented" TargetType="TextBlock" BasedOn="{StaticResource IrHint}">
        <Setter Property="Margin" Value="68,3,0,12"/>
    </Style>

    <!-- Same hint, no indent: prose under a section bar or inside a card. -->
    <Style x:Key="IrHintFlush" TargetType="TextBlock" BasedOn="{StaticResource IrHint}">
        <Setter Property="Margin" Value="0,1,0,8"/>
    </Style>

    <Style x:Key="IrWarning" TargetType="TextBlock" BasedOn="{StaticResource IrHint}">
        <Setter Property="Foreground" Value="{StaticResource IrWarn}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="IrWarningFlush" TargetType="TextBlock" BasedOn="{StaticResource IrWarning}">
        <Setter Property="Margin" Value="0,1,0,8"/>
    </Style>

    <Style x:Key="IrLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource IrText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="IrValue" TargetType="TextBlock" BasedOn="{StaticResource IrLabel}">
        <Setter Property="Foreground" Value="{StaticResource IrAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
        <Setter Property="MinWidth" Value="48"/>
    </Style>

    <!-- A status line under a field: the glyph and message share one colour, which the view
         model chooses - so Foreground is bound there rather than set here. -->
    <Style x:Key="IrStatus" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================== Cards ============================== -->

    <!-- Smoked glass laid on the ground, with a bevelled edge lit top-left. The alpha stays near
         0xE6 so the ground's diagonal still shows through. -->
    <LinearGradientBrush x:Key="IrGlassNeutral" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F21D2329"/>
        <GradientStop Offset="0.68" Color="#EC14191F"/>
        <GradientStop Offset="1" Color="#E90D1319"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IrGlassWarn" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E61E180D"/>
        <GradientStop Offset="1" Color="#E6100C06"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IrGlassDanger" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E6301416"/>
        <GradientStop Offset="1" Color="#E61C0B0C"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="IrBevelNeutral" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#A497BE"/>
        <GradientStop Offset="0.12" Color="#736690"/>
        <GradientStop Offset="0.55" Color="#443C58"/>
        <GradientStop Offset="1"    Color="#221E2C"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IrBevelWarn" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#E0BC70"/>
        <GradientStop Offset="0.12" Color="#B99548"/>
        <GradientStop Offset="0.55" Color="#7E6329"/>
        <GradientStop Offset="1"    Color="#453516"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IrBevelDanger" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#D07A78"/>
        <GradientStop Offset="0.12" Color="#A85350"/>
        <GradientStop Offset="0.55" Color="#743634"/>
        <GradientStop Offset="1"    Color="#3E1D1C"/>
    </LinearGradientBrush>

    <Style x:Key="IrCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource IrGlassNeutral}"/>
        <Setter Property="BorderBrush" Value="#3547D7E9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.28"/></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
    </Style>

    <!-- Important on/off cards get a stronger accent edge. They are used for feature switches,
         so the page communicates state and hierarchy before the user reads the helper text. -->
    <Style x:Key="IrCardFeature" TargetType="Border" BasedOn="{StaticResource IrCard}">
        <Setter Property="BorderBrush" Value="#6A32CFE5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F0182029" Offset="0"/><GradientStop Color="#F00C151D" Offset="0.55"/><GradientStop Color="#E6071119" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
    </Style>

    <!-- Small utility cards should not visually compete with primary feature settings. -->
    <Style x:Key="IrCardCompact" TargetType="Border" BasedOn="{StaticResource IrCard}">
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Caveats, anything with a "but" in it. -->
    <Style x:Key="IrCardWarn" TargetType="Border" BasedOn="{StaticResource IrCard}">
        <Setter Property="Background" Value="{StaticResource IrGlassWarn}"/>
        <Setter Property="BorderBrush" Value="{StaticResource IrBevelWarn}"/>
    </Style>

    <!-- "This cannot be undone." Reserved for destructive actions; used for ordinary caution
         it stops meaning anything. -->
    <Style x:Key="IrCardDanger" TargetType="Border" BasedOn="{StaticResource IrCard}">
        <Setter Property="Background" Value="{StaticResource IrGlassDanger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource IrBevelDanger}"/>
    </Style>

    <!-- A card's own heading: two steps clear of a label in size and weight, so a card of rows
         does not read as four labels with the first slightly bolder. -->
    <Style x:Key="IrCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource IrText}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="IrCardTitleDanger" TargetType="TextBlock" BasedOn="{StaticResource IrCardTitle}">
        <Setter Property="Foreground" Value="{StaticResource IrDanger}"/>
    </Style>

    <!-- General-page overview cards: larger click targets and less visual noise than the
         full settings cards used deeper in the plugin. -->
    <Style x:Key="IrOverviewCard" TargetType="Border" BasedOn="{StaticResource IrCard}">
        <Setter Property="Padding" Value="18,17"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="MinHeight" Value="142"/>
        <Setter Property="Background" Value="#D9192229"/>
        <Setter Property="BorderBrush" Value="#4932CFE5"/>
    </Style>

    <Style x:Key="IrOverviewTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource IrText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="IrOverviewText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource IrTextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>

    <Style x:Key="IrEyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource IrAccent}"/>
    </Style>

    <Style x:Key="IrToolsCalloutCard" TargetType="Border" BasedOn="{StaticResource IrCard}">
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Background" Value="#D9152026"/>
        <Setter Property="BorderBrush" Value="#5A32CFE5"/>
    </Style>

    <Style x:Key="IrAdvancedNote" TargetType="Border">
        <Setter Property="Background" Value="#261E2B31"/>
        <Setter Property="BorderBrush" Value="#344C626D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <!-- ============================== Toggle ============================== -->

    <!-- A machined panel switch: a recessed groove, a bevelled cap lit from above, an indicator
         sunk into the cap. Sized against the 12.5px label beside it so the two read as one row.
         Background, BorderBrush and Tag carry the ON colours, so a derived style can recolour the
         switch without restating the template. -->
    <SolidColorBrush x:Key="IrToggleTrackOff" Color="#34434B"/>
    <SolidColorBrush x:Key="IrToggleTrackOn" Color="#32CFE5"/>
    <SolidColorBrush x:Key="IrToggleThumb" Color="#FFFFFFFF"/>
    <Style x:Key="IrToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource IrText}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,7,0,0"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" Background="Transparent"><Grid Width="32" Height="18" VerticalAlignment="Center"><Border x:Name="Track" Background="{StaticResource IrToggleTrackOff}" CornerRadius="9" BorderBrush="#38FFFFFF" BorderThickness="1"/><Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2" HorizontalAlignment="Left" Fill="{StaticResource IrToggleThumb}"><Ellipse.Effect><DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.35"/></Ellipse.Effect></Ellipse></Grid><ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource IrToggleTrackOn}"/><Setter TargetName="Track" Property="BorderBrush" Value="#B032CFE5"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#CCFFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.35"/><Setter TargetName="Thumb" Property="Opacity" Value="0.45"/><Setter TargetName="Label" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="IrToggleChild" TargetType="CheckBox" BasedOn="{StaticResource IrToggle}"><Setter Property="Margin" Value="28,7,0,0"/></Style>

    <!-- Label-free switch used when the card itself already names the setting. -->
    <Style x:Key="IrToggleSwitchOnly" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="32" Height="18">
                        <Border x:Name="Track" Background="{StaticResource IrToggleTrackOff}" CornerRadius="9" BorderBrush="#38FFFFFF" BorderThickness="1"/>
                        <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2" HorizontalAlignment="Left" Fill="{StaticResource IrToggleThumb}">
                            <Ellipse.Effect><DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.35"/></Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource IrToggleTrackOn}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#B032CFE5"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#CCFFFFFF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.35"/><Setter TargetName="Thumb" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Radio ============================== -->

    <!-- Circular where the toggle is square: the shape is the affordance. Same construction -
         recessed well, bevelled rim, a lit dot when selected. -->
    <SolidColorBrush x:Key="IrWellFace" Color="#151D23"/><SolidColorBrush x:Key="IrWellRim" Color="#53656F"/>
    <Style x:Key="IrRadio" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource IrText}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,7,0,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><StackPanel Orientation="Horizontal" Background="Transparent"><Grid Width="16" Height="16" VerticalAlignment="Center"><Ellipse x:Name="Well" Fill="{StaticResource IrWellFace}" Stroke="{StaticResource IrWellRim}" StrokeThickness="1"/><Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource IrAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/></Grid><ContentPresenter x:Name="Label" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Opacity" Value="1"/><Setter TargetName="Well" Property="Stroke" Value="{StaticResource IrAccent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Well" Property="Stroke" Value="#B032CFE5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Well" Property="Opacity" Value="0.35"/><Setter TargetName="Label" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

    <!-- Hint under a radio: lines up with its label. 14 well + 8 gap. -->
    <Style x:Key="IrRadioHint" TargetType="TextBlock" BasedOn="{StaticResource IrHint}">
        <Setter Property="Margin" Value="22,1,0,6"/>
    </Style>

    <!-- ============================== Inputs ============================== -->

    <!-- A recess rather than a raised panel - the inverse of the button, which is what an input
         should read as. Left unstyled it renders as WPF's stark white box. -->
    <Style x:Key="IrTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource IrText}"/>
        <Setter Property="CaretBrush" Value="{StaticResource IrAccent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource IrAccent}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource IrWellFace}"/>
        <Setter Property="BorderBrush" Value="{StaticResource IrWellRim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Well" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="{StaticResource IrAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="{StaticResource IrStrokeHi}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Well" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IrSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource IrAccent}"/>
        <Setter Property="Background" Value="{StaticResource IrSurfaceHi}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <!-- Transparent, not empty: a zero-size template makes
                                                 the track un-clickable. -->
                                            <Border Background="Transparent" Height="18">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{StaticResource IrAccent}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Height="18"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource IrText}"
                                                     Stroke="{StaticResource IrGround}"
                                                     StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Buttons ============================== -->

    <!-- The same bevelled panel as the cards, at control scale. Pressed inverts the bevel. -->
    <SolidColorBrush x:Key="IrButtonFace" Color="#1732CFE5"/><SolidColorBrush x:Key="IrButtonFaceHover" Color="#2732CFE5"/><SolidColorBrush x:Key="IrButtonRim" Color="#6A32CFE5"/><SolidColorBrush x:Key="IrButtonDangerFace" Color="#26FF5C5C"/><SolidColorBrush x:Key="IrButtonDangerRim" Color="#A6FF5C5C"/>
    <Style x:Key="IrButton" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource IrText}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="15,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="{StaticResource IrButtonFace}"/><Setter Property="BorderBrush" Value="{StaticResource IrButtonRim}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource IrButtonFaceHover}"/><Setter TargetName="Face" Property="BorderBrush" Value="#B032CFE5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#1232CFE5"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FFE6B86A"/><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="IrButtonSecondary" TargetType="Button" BasedOn="{StaticResource IrButton}">
        <Setter Property="Background" Value="#0EFFFFFF"/>
        <Setter Property="BorderBrush" Value="#3FFFFFFF"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="IrButtonDanger" TargetType="Button" BasedOn="{StaticResource IrButton}"><Setter Property="Background" Value="{StaticResource IrButtonDangerFace}"/><Setter Property="BorderBrush" Value="{StaticResource IrButtonDangerRim}"/></Style>

    <!-- ============================== Navigation rail ============================== -->

    <!-- A full-width row that marks selection with a left accent bar - the TabItem's own left
         border, so nothing has to be kept in sync with the row's height. -->
    <Style x:Key="IrRailItem" TargetType="TabItem"><Setter Property="Width" Value="190"/><Setter Property="MinHeight" Value="46"/><Setter Property="Margin" Value="0,0,14,6"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="4,0,0,0" CornerRadius="0,10,10,0" Padding="17,11" Cursor="Hand" TextElement.Foreground="{StaticResource IrTextMuted}" TextElement.FontSize="13" TextElement.FontWeight="SemiBold"><ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1432CFE5"/><Setter TargetName="Row" Property="TextElement.Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#2032CFE5"/><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource IrAccent}"/><Setter TargetName="Row" Property="TextElement.Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="IrRail" TargetType="TabControl"><Setter Property="ItemContainerStyle" Value="{StaticResource IrRailItem}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#C911171D" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0" Padding="0,14,0,14"><StackPanel IsItemsHost="True" MinWidth="204"/></Border><ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>

    <!-- The strip along the top of a rail entry: its pages. Underlined rather than a second
         boxed tab, so it reads as subordinate to the rail instead of competing with it. -->
    <Style x:Key="IrStripItem" TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Tab"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="13,8,13,6"
                            Cursor="Hand"
                            TextElement.Foreground="{StaticResource IrTextMuted}"
                            TextElement.FontSize="12"
                            TextElement.FontWeight="Normal">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tab" Property="TextElement.Foreground" Value="{StaticResource IrText}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource IrAccent}"/>
                            <Setter TargetName="Tab" Property="TextElement.Foreground" Value="{StaticResource IrText}"/>
                            <Setter TargetName="Tab" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keyed, not implicit: an implicit TabControl style would cascade into the pages. -->
    <Style x:Key="IrStrip" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource IrStripItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="#D91A2026"
                                BorderBrush="{StaticResource IrStroke}"
                                BorderThickness="0,0,0,1"
                                Padding="8,0,8,0">
                            <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

