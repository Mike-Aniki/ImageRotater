<UserControl x:Class="ImageRotater.Controls.SteamGridDbSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Playnite's WindowBase never sets Foreground, so a bare TextBlock in a
             plugin window falls back to the system control colour - black on a dark
             theme. Playnite's own windows fix this the same way (AboutWindow.xaml). -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">

            <!-- Sources are peers, not a primary and a fallback. Results share
                 the same shape, so the filters, click-to-select and download
                 below work on either. Switching tabs re-runs the search so the
                 results always match the visible tab. -->
            <TabControl x:Name="SourceTabs"
                        Margin="0,0,0,8"
                        SelectionChanged="SourceTabs_SelectionChanged">
                <!-- Ordered by how reliably the result can actually be shown.
                     Steam serves plain JPEG that WPF decodes natively, needs no
                     API key and no external tool - so it is the one that always
                     works, and goes first. SteamGridDB has far more choice but
                     its animated results are WebP with WebM thumbnails, which
                     WPF cannot decode without ffmpeg. Web search is anything at
                     all. YouTube needs yt-dlp on top. -->
                <TabItem x:Name="SteamTab" Header="{DynamicResource LOCImageRotaterSteam}">
                    <TextBlock x:Name="SteamTabNote"
                               Text="{DynamicResource LOCImageRotaterSteamSearchHelp}"
                               FontSize="11"
                               Foreground="Gray"
                               Margin="6,4"/>
                </TabItem>
                <TabItem x:Name="SteamGridDbTab" Header="{DynamicResource LOCImageRotaterSteamGridDB}">
                    <TextBlock Text="{DynamicResource LOCImageRotaterSgdbSearchHelp}"
                               FontSize="11"
                               Foreground="Gray"
                               Margin="6,4"/>
                </TabItem>
                <TabItem x:Name="WebTab" Header="{DynamicResource LOCImageRotaterWebSearch}">
                    <TextBlock Text="{DynamicResource LOCImageRotaterWebSearchHelp}"
                               FontSize="11"
                               Foreground="Gray"
                               Margin="6,4"/>
                </TabItem>
                <TabItem x:Name="YouTubeTab" Header="{DynamicResource LOCImageRotaterYouTube}">
                    <TextBlock x:Name="YouTubeTabNote"
                               Text="{DynamicResource LOCImageRotaterYouTubeSearchHelp}"
                               FontSize="11"
                               Foreground="Gray"
                               Margin="6,4"/>
                </TabItem>
            </TabControl>

        <DockPanel>
            <Button x:Name="SearchButton"
                    Content="{DynamicResource LOCImageRotaterSearch}"
                    DockPanel.Dock="Right"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Click="SearchButton_Click"/>

            <!-- Fullscreen only. The filter column starts collapsed there, so
                 this is how a controller user gets it back without a mouse. -->
            <ToggleButton x:Name="FilterToggleRow"
                          Content="{DynamicResource LOCImageRotaterFilters}"
                          DockPanel.Dock="Right"
                          MinWidth="90"
                          Margin="8,0,0,0"
                          Visibility="Collapsed"
                          Checked="FilterToggle_Changed"
                          Unchecked="FilterToggle_Changed"/>

            <TextBox x:Name="SearchBox"
                     VerticalContentAlignment="Center"
                     Padding="4"
                     KeyDown="SearchBox_KeyDown"/>
        </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Collapsed to zero in Fullscreen, where the filter column
                     would eat a third of a TV screen for controls a controller
                     user rarely touches. The Filters button restores it. -->
                <ColumnDefinition x:Name="FiltersColumn" Width="220"/>
                <ColumnDefinition Width="*"/>
                <!-- Preview panel. Starts collapsed and opens when a result's
                     preview button is pressed - a permanently empty third of
                     the dialog would be worse than no panel at all. -->
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Filters, built from whatever the current results contain -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCImageRotaterShapeAndSize}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding AspectGroups}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Collapsed by default. A result set spans a
                                     dozen resolutions across five or six
                                     shapes, and the shape is what people pick
                                     by: ticking the group ticks every
                                     dimension under it, so "all square covers"
                                     is one click with nothing expanded. -->
                                <Expander IsExpanded="{Binding IsExpanded}"
                                          Margin="0,0,0,4">
                                    <Expander.Header>
                                        <CheckBox Content="{Binding Display}"
                                                  IsChecked="{Binding IsChecked}"
                                                  FontWeight="SemiBold"
                                                  Margin="0,2"/>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Dimensions}"
                                                  Margin="18,2,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsChecked}"
                                                          Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource LOCImageRotaterStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding StyleOptions}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsChecked}"
                                          Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Format, kept apart from the content warnings below.
                         Those three are "show me something I might not want to
                         see"; this one is "what kind of file is it" - unrelated
                         questions that only looked alike by sitting together.

                         No per-format note here any more. It listed which
                         formats animate WHERE, and that answer depends on the
                         theme rather than on the plugin, so it went stale the
                         moment a theme changed. -->
                    <TextBlock Text="{DynamicResource LOCImageRotaterAnimationFilter}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <!-- On by default now that animated results no longer crash
                         the preview. Animated artwork is the reason most people
                         open this dialog, and hiding it behind a filter meant
                         the good results were invisible until you knew to ask.

                         Every filter in this column applies as it is ticked.
                         They all narrow what is already on screen - no
                         request is involved - so an Apply button was pure
                         ceremony and made the boxes look broken. -->
                    <CheckBox x:Name="ShowAnimatedBox"
                              Content="{DynamicResource LOCImageRotaterShowAnimated}"
                              IsChecked="True"
                              Checked="ContentFilter_Changed"
                              Unchecked="ContentFilter_Changed"
                              Margin="0,2"/>

                    <!-- On by default. Smaller on disk, and MP4 plays through
                         MediaElement - hardware-assisted - where a GIF decodes
                         frame by frame on the UI thread. Disabled outright when
                         ffmpeg is missing, with the label saying so, rather
                         than silently doing nothing. -->
                    <CheckBox x:Name="ConvertGifsBox"
                              Content="{DynamicResource LOCImageRotaterConvertGifsOnDownload}"
                              IsChecked="True"
                              Margin="0,2,0,2"/>
                    <TextBlock x:Name="ConvertGifsNote"
                               Text="{DynamicResource LOCImageRotaterGifConvertHint}"
                               FontSize="10"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource LOCImageRotaterAlsoShow}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ShowNsfwBox" Content="{DynamicResource LOCImageRotaterAdultContent}" Margin="0,2"
                              Checked="ContentFilter_Changed" Unchecked="ContentFilter_Changed"/>
                    <CheckBox x:Name="ShowHumorBox" Content="{DynamicResource LOCImageRotaterHumour}" Margin="0,2"
                              Checked="ContentFilter_Changed" Unchecked="ContentFilter_Changed"/>
                    <CheckBox x:Name="ShowEpilepsyBox" Content="{DynamicResource LOCImageRotaterFlashingImages}" Margin="0,2"
                              Checked="ContentFilter_Changed" Unchecked="ContentFilter_Changed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Results -->
            <ListBox Grid.Column="1"
                     x:Name="ResultsList"
                     ItemsSource="{Binding Results}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- Selection is the tiles' own toggle state, so the ListBox must
                     not also track a selection - two competing highlights, and a
                     click would mean both "toggle this" and "select this".
                     The container therefore stays unfocusable and untemplated;
                     the ToggleButton inside each tile is what takes focus, which
                     is what makes D-pad navigation land on something that can
                     actually be activated. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- The whole tile is the hit target, not just a checkbox.
                             Bound to the model rather than ListBox.SelectedItems so a
                             tick survives re-filtering: applying a filter rebuilds the
                             list and would otherwise drop it silently.
                             A ToggleButton rather than a CheckBox with content, because
                             its template can be replaced outright - a CheckBox would
                             still draw its own box beside the image.
                             Style is nulled so the theme's implicit ToggleButton style
                             cannot reach in: the template below is the whole look, and a
                             theme that sizes its toggles (Mythos sets Height=28) would
                             otherwise squash every tile to a 28px strip. -->
                        <ToggleButton Style="{x:Null}"
                                      Foreground="{DynamicResource TextBrush}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Cursor="Hand"
                                      ToolTip="{DynamicResource LOCImageRotaterSelectTooltip}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <!-- Tile width comes from the view, not a
                                         literal: Fullscreen is read from a sofa
                                         and 240px of artwork that is comfortable
                                         on a monitor is a postage stamp on a TV.
                                         Set once in code from the application
                                         mode. -->
                                    <Border x:Name="Frame"
                                            Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="6"
                                            Padding="6"
                                            CornerRadius="3"
                                            Background="Transparent"
                                            BorderThickness="2"
                                            BorderBrush="Transparent">
                                        <StackPanel>
                                            <!-- Centred so the badge below sits on
                                                 the image, not the tile's corner,
                                                 when the image is narrower than
                                                 the box. -->
                                            <Grid HorizontalAlignment="Center">
                                                <!-- Every tile shows the static THUMBNAIL, animated
                                                     or not.

                                                     GIFs used to play here, which meant handing
                                                     XamlAnimatedGif the full-size remote URL for
                                                     every visible result - a dozen whole GIFs
                                                     downloading and decoding at once, on the UI
                                                     thread, in a 32-bit process. That froze and
                                                     crashed Playnite, worst on a web search where
                                                     results have no size ceiling.

                                                     Animation lives in the preview window now:
                                                     one file at a time, and only when asked for.

                                                     Uniform, not UniformToFill: the whole image,
                                                     letterboxed if need be. Filling the box cropped
                                                     every square cover to a banner strip, so the
                                                     result on screen was not the result on offer. -->
                                                <Image Height="{Binding ThumbnailHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Stretch="Uniform"
                                                       Source="{Binding ThumbnailUrl}"
                                                       Loaded="ResultImage_Loaded"
                                                       MouseEnter="ResultImage_MouseEnter"
                                                       MouseLeave="ResultImage_MouseLeave"/>

                                                <!-- Badge so animated results are identifiable at a
                                                     glance even before the frames arrive. -->
                                                <!-- Badged for ANY animated format, not just GIF.
                                                     Every animated result SteamGridDB returns is
                                                     WebP with a WebM thumbnail, so a GIF-only badge
                                                     marked almost nothing - and WPF can decode
                                                     neither, so those tiles were unlabelled AND
                                                     frequently blank. -->
                                                <Border Visibility="{Binding IsAnimated, Converter={StaticResource BoolToVisibility}}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="4"
                                                        Padding="4,1"
                                                        CornerRadius="3"
                                                        Background="#B0000000">
                                                    <TextBlock Text="{DynamicResource LOCImageRotaterAnimatedBadge}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>

                                                <!-- Length, on video results only.
                                                     A background loops, so a 20-second
                                                     clip reads very differently from a
                                                     ten-minute one - and it is the only
                                                     hint before committing to a download.

                                                     Bottom LEFT. It was bottom-right,
                                                     underneath the preview button, which
                                                     is 26x26, opaque, in the same cell and
                                                     declared after it - so a later sibling
                                                     painted straight over it and the
                                                     duration was never once visible. The
                                                     button's own comment says it was put
                                                     there to clear the ANIMATED badge and
                                                     the tick; this badge arrived
                                                     afterwards and took the last free
                                                     corner it did not have. -->
                                                <Border Visibility="{Binding IsYouTube, Converter={StaticResource BoolToVisibility}}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Margin="4"
                                                        Padding="4,1"
                                                        CornerRadius="3"
                                                        Background="#B0000000">
                                                    <TextBlock Text="{Binding DurationText}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>

                                                <!-- Only shown once selected, so an
                                                     unpicked grid stays uncluttered. -->
                                                <Border x:Name="Tick"
                                                        Visibility="Collapsed"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="4"
                                                        Width="22" Height="22"
                                                        CornerRadius="11"
                                                        Background="{DynamicResource GlyphBrush}">
                                                    <TextBlock Text="&#x2713;"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrushDarker}"/>
                                                </Border>

                                                <!-- Opens the full image, at size, in its own
                                                     window - and it is where an animated result
                                                     actually plays.

                                                     A thumbnail says almost nothing about whether a
                                                     1920x620 banner is the right shape for a
                                                     background, or how much a GIF actually moves.
                                                     Bottom-right so it does not sit under the GIF
                                                     badge or the selection tick. -->
                                                <Button Content="&#x1F441;"
                                                        ToolTip="{DynamicResource LOCImageRotaterPreviewFullTooltip}"
                                                        Click="Preview_Click"
                                                        Tag="{Binding}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="4"
                                                        Width="26" Height="26"
                                                        Padding="0"
                                                        FontSize="13"
                                                        Focusable="False"/>
                                            </Grid>

                                            <!-- Size and the real file format. The
                                                 format matters because WPF cannot
                                                 display all of them - a WEBP will
                                                 not show here even though it
                                                 downloads fine.

                                                 CaptionText rather than Dimensions:
                                                 a YouTube result has no size to state.
                                                 See the property. -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,4,0,0">
                                                <TextBlock Text="{Binding CaptionText}"/>
                                                <TextBlock Text="{Binding FormatLabel}"
                                                           Margin="6,0,0,0"
                                                           Foreground="Gray"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Style}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Frame" Property="BorderBrush"
                                                    Value="{DynamicResource GlyphBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Frame" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>

                                        <!-- Where the D-pad is.
                                             Without this a controller user has no
                                             idea which tile Enter would activate -
                                             the tick marks what is SELECTED, which
                                             is a different question. Brighter than
                                             the hover wash so the two read apart
                                             when a mouse and a pad are both in
                                             use. -->
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Frame" Property="Background" Value="#33FFFFFF"/>
                                            <Setter TargetName="Frame" Property="BorderBrush"
                                                    Value="{DynamicResource TextBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Preview panel.
                 In the dialog rather than a modal window on purpose: a modal
                 has to be dismissed before the next result can be looked at,
                 which makes comparing two candidates a chore. This stays open
                 while the grid is browsed. -->
            <Border x:Name="PreviewPanel"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="PreviewCloseButton"
                                Content="&#x2715;"
                                DockPanel.Dock="Right"
                                Width="24"
                                Height="24"
                                Padding="0"
                                ToolTip="{DynamicResource LOCImageRotaterClosePreviewTooltip}"
                                Click="PreviewClose_Click"/>
                        <TextBlock x:Name="PreviewTitle"
                                   Text="{DynamicResource LOCImageRotaterPreview}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <TextBlock x:Name="PreviewStatus"
                               DockPanel.Dock="Bottom"
                               FontSize="11"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <!-- Both renderers live here; whichever is unused stays
                         collapsed. Swapping children at runtime instead would
                         mean rebuilding the visual tree on every preview. -->
                    <Grid>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        <!-- The web view is added here in code, not markup.
                             It needs its environment created before it can be
                             initialised, and that is async - which XAML cannot
                             express. See PreviewRenderer. -->
                        <ContentControl x:Name="PreviewVideoHost"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status + actions -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <!-- Close sits at the far right, the primary action beside it -
                 the order every dialog on the platform uses. -->
            <Button x:Name="CloseDialogButton"
                    Content="{DynamicResource LOCImageRotaterClose}"
                    DockPanel.Dock="Right"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Click="CloseButton_Click"/>

            <!-- Accent-coloured so the one button that does something is
                 not a twin of the one that leaves. HighlightGlyphBrush is the
                 accent every Playnite theme defines; the templates bind
                 Background and BorderBrush, so it takes without a style of
                 our own. White on an accent reads on light and dark themes
                 alike, where the theme's TextBrush only suits one of them. -->
            <Button x:Name="DownloadButton"
                    Content="{DynamicResource LOCImageRotaterDownloadSelected}"
                    DockPanel.Dock="Right"
                    MinWidth="140"
                    Margin="8,0,0,0"
                    Background="{DynamicResource HighlightGlyphBrush}"
                    BorderBrush="{DynamicResource HighlightGlyphBrush}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="DownloadButton_Click"/>

            <!-- Paging, shown only when there is more than one page.
                 A web search can return a hundred hits, and every visible tile
                 fetches and decodes a remote thumbnail - so a page is a ceiling
                 on how much work one search starts, not a layout preference. -->
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVisibility}}">
                <Button Content="&#x25C0;"
                        Width="30"
                        Padding="0"
                        IsEnabled="{Binding CanGoBack}"
                        Click="PreviousPage_Click"/>
                <TextBlock Text="{Binding PageLabel}"
                           VerticalAlignment="Center"
                           Margin="8,0"
                           FontSize="11"/>
                <Button Content="&#x25B6;"
                        Width="30"
                        Padding="0"
                        IsEnabled="{Binding CanGoForward}"
                        Click="NextPage_Click"/>
            </StackPanel>
            <!-- Foreground must be set explicitly. Without it the TextBlock
                 inherits WPF's default black, which is unreadable on a dark
                 Playnite theme - the status was effectively invisible.
                 TextBrush follows whatever theme is active; the literal is only
                 a fallback for a theme that omits it, since DynamicResource has
                 no FallbackValue of its own. -->
            <Border Padding="8,5"
                    CornerRadius="3"
                    Background="#22808080">
                <StackPanel Orientation="Horizontal">

                    <!-- Spins only while a search is running, so "working" and
                         "finished with nothing" stop looking identical. -->
                    <TextBlock x:Name="BusyGlyph"
                               Text="&#x25CF;"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource GlyphBrush}"
                               Visibility="Collapsed">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="Pulse">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.15" Duration="0:0:0.6"
                                                                     AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Pulse"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding Status}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
