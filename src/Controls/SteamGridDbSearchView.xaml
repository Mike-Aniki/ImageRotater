<UserControl x:Class="ImageRotater.Controls.SteamGridDbSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Playnite's WindowBase never sets Foreground, so a bare TextBlock in a
             plugin window falls back to the system control colour - black on a dark
             theme. Playnite's own windows fix this the same way (AboutWindow.xaml). -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF2F5"/>
        </Style>

        <!-- Manager-local styling: same visual language as the redesigned settings,
             without changing the search engine or its controller behaviour. -->
        <!-- One interaction language everywhere: neutral at rest, subtle on hover,
             cyan focus ring only on the control that actually owns keyboard/controller focus. -->
        <!-- One button language across Search Online: neutral at rest, subtle hover,
             and a complete cyan border only on the control that owns focus. -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#182229"/>
            <Setter Property="BorderBrush" Value="#34464F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EAF2F5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D2B32"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#49616B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#173640"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#39CFE5"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#204853"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#141D22"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2A3940"/>
                                <Setter Property="Foreground" Value="#718087"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#10181D"/>
            <Setter Property="BorderBrush" Value="#38505A"/>
            <Setter Property="Foreground" Value="#EAF2F5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <!-- Source navigation is rendered with standalone radio buttons rather than
             TabItems. This prevents Playnite themes from merging/cropping tab borders. -->
        <Style x:Key="SearchSourceNavStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B7C4CB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SourceBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SourceBorder" Property="Background" Value="#19262C"/>
                                <Setter TargetName="SourceBorder" Property="BorderBrush" Value="#3C515A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SourceBorder" Property="Background" Value="#203840"/>
                                <Setter TargetName="SourceBorder" Property="BorderBrush" Value="#39CFE5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SourceBorder" Property="Background" Value="#173640"/>
                                <Setter TargetName="SourceBorder" Property="BorderBrush" Value="#55DDED"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact custom checkbox used by filter lists so Playnite/theme checkbox
             chrome cannot introduce a second visual language. -->
        <Style x:Key="FilterCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAF2F5"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Panel.ZIndex" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="14" Height="14"
                                    Background="#0D151A"
                                    BorderBrush="#40515A"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Tick" Text="✓" FontSize="11" FontWeight="Bold"
                                           Foreground="#39C6D4" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="#EAF2F5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#15333B"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#39C6D4"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#5D737D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchAspectExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Foreground" Value="#EAF2F5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="AspectHeader"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          FocusVisualStyle="{x:Null}"
                                          Background="Transparent" BorderThickness="0" Padding="0" Foreground="#EAF2F5">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="AspectRow" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="6" Padding="7,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="AspectChevron" Data="M 2 4 L 7 9 L 12 4"
                                                      Stroke="#65B9C6" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1" Margin="7,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="#EAF2F5"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="AspectChevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                                <Setter TargetName="AspectRow" Property="Background" Value="#14252B"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AspectRow" Property="Background" Value="#172A31"/>
                                                <Setter TargetName="AspectRow" Property="BorderBrush" Value="#314A54"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="AspectRow" Property="BorderBrush" Value="#39C6D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="AspectContent" ContentSource="Content"
                                              Margin="20,3,0,6" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="AspectContent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchFilterExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#EAF2F5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderButton"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          FocusVisualStyle="{x:Null}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          HorizontalContentAlignment="Stretch" Foreground="#EAF2F5">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder"
                                                Background="#121B20"
                                                BorderBrush="#30434C"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="9,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Chevron"
                                                      Data="M 2 4 L 7 9 L 12 4"
                                                      Stroke="#55C8D8"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="7,0,0,0"
                                                                  TextElement.Foreground="#EAF2F5"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#18333B"/>
                                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#3B6872"/>
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#1B2930"/>
                                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#49616B"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#173640"/>
                                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#39C6D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              ContentSource="Content"
                                              Margin="8,2,0,6"
                                              Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Panel.ZIndex" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="Grip" Width="2" CornerRadius="1"
                                    Background="#263E48" HorizontalAlignment="Center"
                                    Margin="0,10"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Width" Value="3"/>
                                <Setter TargetName="Grip" Property="Background" Value="#39C6D4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Grip" Property="Width" Value="3"/>
                                <Setter TargetName="Grip" Property="Background" Value="#39C6D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DownloadActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#173640"/>
            <Setter Property="BorderBrush" Value="#39CFE5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>


        <Style x:Key="SearchSectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#EAF2F5"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="SearchRoot" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">

            <!-- Sources are peers, not a primary and a fallback. Results share
                 the same shape, so the filters, click-to-select and download
                 below work on either. Switching tabs re-runs the search so the
                 results always match the visible tab. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="SteamSourceButton"
                             GroupName="SearchSources"
                             Style="{StaticResource SearchSourceNavStyle}"
                             Content="{DynamicResource LOCImageRotaterSteam}"
                             Tag="SteamTab"
                             IsChecked="True"
                             Checked="SourceNav_Checked"/>
                <RadioButton x:Name="SteamGridDbSourceButton"
                             GroupName="SearchSources"
                             Style="{StaticResource SearchSourceNavStyle}"
                             Content="{DynamicResource LOCImageRotaterSteamGridDB}"
                             Tag="SteamGridDbTab"
                             Checked="SourceNav_Checked"/>
                <RadioButton x:Name="WebSourceButton"
                             GroupName="SearchSources"
                             Style="{StaticResource SearchSourceNavStyle}"
                             Content="{DynamicResource LOCImageRotaterWebSearch}"
                             Tag="WebTab"
                             Checked="SourceNav_Checked"/>
                <RadioButton x:Name="YouTubeSourceButton"
                             GroupName="SearchSources"
                             Style="{StaticResource SearchSourceNavStyle}"
                             Content="{DynamicResource LOCImageRotaterYouTube}"
                             Tag="YouTubeTab"
                             Margin="0"
                             Checked="SourceNav_Checked"/>
            </StackPanel>

            <!-- Internal source state only. No native TabItem chrome is rendered. -->
            <TabControl x:Name="SourceTabs"
                        Visibility="Collapsed"
                        SelectionChanged="SourceTabs_SelectionChanged">
                <TabItem x:Name="SteamTab"/>
                <TabItem x:Name="SteamGridDbTab"/>
                <TabItem x:Name="WebTab"/>
                <TabItem x:Name="YouTubeTab"/>
            </TabControl>

        <DockPanel>
            <Button x:Name="SearchButton"
                    Content="{DynamicResource LOCImageRotaterSearch}"
                    DockPanel.Dock="Right"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Click="SearchButton_Click"/>

            <!-- Fullscreen only. The filter column starts collapsed there, so
                 this is how a controller user gets it back without a mouse. -->
            <ToggleButton x:Name="FilterToggleRow"
                          Content="{DynamicResource LOCImageRotaterFilters}"
                          DockPanel.Dock="Right"
                          MinWidth="90"
                          Margin="8,0,0,0"
                          Visibility="Collapsed"
                          Checked="FilterToggle_Changed"
                          Unchecked="FilterToggle_Changed"/>

            <TextBox x:Name="SearchBox"
                     VerticalContentAlignment="Center"
                     Padding="4"
                     KeyDown="SearchBox_KeyDown"/>
        </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Desktop users can resize the filter rail. Fullscreen still starts
                     collapsed and exposes it through the Filters toggle. -->
                <ColumnDefinition x:Name="FiltersColumn" Width="350" MinWidth="260" MaxWidth="520"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <!-- Preview opens on demand, so it never steals space while browsing. -->
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Resize handle between filters and results. -->
            <GridSplitter x:Name="FiltersSplitter"
                          Grid.Column="1"
                          Width="7"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Style="{StaticResource SearchSplitterStyle}"
                          ShowsPreview="False"
                          Cursor="SizeWE"/>

            <!-- Filters, built from whatever the current results contain -->
            <Border Grid.Column="0"
                    Margin="0,0,4,0"
                    Padding="12"
                    Background="#0F171C"
                    BorderBrush="#2A414A"
                    BorderThickness="1"
                    CornerRadius="9">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource LOCImageRotaterFilters}"
                                   Foreground="#FFFFFF"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ClearFiltersButton"
                                Grid.Column="1"
                                Content="{DynamicResource LOCImageRotaterClearFilters}"
                                Padding="9,4"
                                MinHeight="28"
                                FontSize="11"
                                Click="ClearFilters_Click"/>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Expander x:Name="SizeFilterSection"
                                      Header="{DynamicResource LOCImageRotaterShapeAndSize}"
                                      Style="{StaticResource SearchFilterExpander}"
                                      IsExpanded="True">
                                <ItemsControl ItemsSource="{Binding AspectGroups}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander IsExpanded="{Binding IsExpanded}" Style="{StaticResource SearchAspectExpander}">
                                                <Expander.Header>
                                                    <CheckBox Content="{Binding Display}"
                                                              IsChecked="{Binding IsChecked}"
                                                              FontWeight="SemiBold"
                                                              Style="{StaticResource FilterCheckBoxStyle}"/>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Dimensions}" Margin="18,2,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Label}"
                                                                      IsChecked="{Binding IsChecked}"
                                                                      Style="{StaticResource FilterCheckBoxStyle}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander x:Name="StyleFilterSection"
                                      Header="{DynamicResource LOCImageRotaterStyle}"
                                      Style="{StaticResource SearchFilterExpander}"
                                      IsExpanded="False">
                                <ItemsControl ItemsSource="{Binding StyleOptions}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}"
                                                      IsChecked="{Binding IsChecked}"
                                                      Style="{StaticResource FilterCheckBoxStyle}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander x:Name="AnimationFilterSection"
                                      Header="{DynamicResource LOCImageRotaterAnimationFilter}"
                                      Style="{StaticResource SearchFilterExpander}"
                                      IsExpanded="True">
                                <StackPanel Margin="0,6,0,0">
                                    <CheckBox x:Name="ShowAnimatedBox"
                                              Style="{StaticResource FilterCheckBoxStyle}"
                                              Content="{DynamicResource LOCImageRotaterShowAnimated}"
                                              IsChecked="True"
                                              Checked="ContentFilter_Changed"
                                              Unchecked="ContentFilter_Changed"
                                              Margin="0,2"/>
                                    <CheckBox x:Name="ConvertGifsBox"
                                              Style="{StaticResource FilterCheckBoxStyle}"
                                              Content="{DynamicResource LOCImageRotaterConvertGifsOnDownload}"
                                              IsChecked="True"
                                              Margin="0,4,0,2"/>
                                    <TextBlock x:Name="ConvertGifsNote"
                                               Text="{DynamicResource LOCImageRotaterGifConvertHint}"
                                               FontSize="10"
                                               Foreground="#8D9BA4"
                                               TextWrapping="Wrap"
                                               Margin="22,0,0,4"/>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="ContentFilterSection"
                                      Header="{DynamicResource LOCImageRotaterAlsoShow}"
                                      Style="{StaticResource SearchFilterExpander}"
                                      IsExpanded="False">
                                <StackPanel Margin="0,6,0,0">
                                    <CheckBox x:Name="ShowNsfwBox" Style="{StaticResource FilterCheckBoxStyle}" Content="{DynamicResource LOCImageRotaterAdultContent}" Margin="0,2"
                                              Checked="ContentFilter_Changed" Unchecked="ContentFilter_Changed"/>
                                    <CheckBox x:Name="ShowHumorBox" Style="{StaticResource FilterCheckBoxStyle}" Content="{DynamicResource LOCImageRotaterHumour}" Margin="0,2"
                                              Checked="ContentFilter_Changed" Unchecked="ContentFilter_Changed"/>
                                    <CheckBox x:Name="ShowEpilepsyBox" Style="{StaticResource FilterCheckBoxStyle}" Content="{DynamicResource LOCImageRotaterFlashingImages}" Margin="0,2"
                                              Checked="ContentFilter_Changed" Unchecked="ContentFilter_Changed"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ResultsLabel}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource LOCImageRotaterClickToSelect}" Foreground="#82939C" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
                <ListBox Grid.Row="1"
                     x:Name="ResultsList"
                     Background="#0B1216"
                     BorderBrush="#263841"
                     BorderThickness="1"
                     Padding="10"
                     ItemsSource="{Binding Results}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- Selection is the tiles' own toggle state, so the ListBox must
                     not also track a selection - two competing highlights, and a
                     click would mean both "toggle this" and "select this".
                     The container therefore stays unfocusable and untemplated;
                     the ToggleButton inside each tile is what takes focus, which
                     is what makes D-pad navigation land on something that can
                     actually be activated. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- The whole tile is the hit target, not just a checkbox.
                             Bound to the model rather than ListBox.SelectedItems so a
                             tick survives re-filtering: applying a filter rebuilds the
                             list and would otherwise drop it silently.
                             A ToggleButton rather than a CheckBox with content, because
                             its template can be replaced outright - a CheckBox would
                             still draw its own box beside the image.
                             Style is nulled so the theme's implicit ToggleButton style
                             cannot reach in: the template below is the whole look, and a
                             theme that sizes its toggles (Mythos sets Height=28) would
                             otherwise squash every tile to a 28px strip. -->
                        <ToggleButton Style="{x:Null}"
                                      Foreground="{DynamicResource TextBrush}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Checked="ResultSelection_Changed"
                                      Unchecked="ResultSelection_Changed"
                                      Cursor="Hand"
                                      ToolTip="{DynamicResource LOCImageRotaterSelectTooltip}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <!-- Tile width comes from the view, not a
                                         literal: Fullscreen is read from a sofa
                                         and 240px of artwork that is comfortable
                                         on a monitor is a postage stamp on a TV.
                                         Set once in code from the application
                                         mode. -->
                                    <Border x:Name="Frame"
                                            Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="6"
                                            Padding="6"
                                            CornerRadius="8"
                                            Background="#10181D"
                                            BorderThickness="1"
                                            BorderBrush="#263D46">
                                        <StackPanel>
                                            <!-- Centred so the badge below sits on
                                                 the image, not the tile's corner,
                                                 when the image is narrower than
                                                 the box. -->
                                            <Grid HorizontalAlignment="Center">
                                                <!-- Every tile shows the static THUMBNAIL, animated
                                                     or not.

                                                     GIFs used to play here, which meant handing
                                                     XamlAnimatedGif the full-size remote URL for
                                                     every visible result - a dozen whole GIFs
                                                     downloading and decoding at once, on the UI
                                                     thread, in a 32-bit process. That froze and
                                                     crashed Playnite, worst on a web search where
                                                     results have no size ceiling.

                                                     Animation lives in the preview window now:
                                                     one file at a time, and only when asked for.

                                                     Uniform, not UniformToFill: the whole image,
                                                     letterboxed if need be. Filling the box cropped
                                                     every square cover to a banner strip, so the
                                                     result on screen was not the result on offer. -->
                                                <Image Height="{Binding ThumbnailHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Stretch="Uniform"
                                                       Source="{Binding ThumbnailUrl}"
                                                       Loaded="ResultImage_Loaded"
                                                       MouseEnter="ResultImage_MouseEnter"
                                                       MouseLeave="ResultImage_MouseLeave"/>

                                                <!-- Badge so animated results are identifiable at a
                                                     glance even before the frames arrive. -->
                                                <!-- Badged for ANY animated format, not just GIF.
                                                     Every animated result SteamGridDB returns is
                                                     WebP with a WebM thumbnail, so a GIF-only badge
                                                     marked almost nothing - and WPF can decode
                                                     neither, so those tiles were unlabelled AND
                                                     frequently blank. -->
                                                <Border Visibility="{Binding IsAnimated, Converter={StaticResource BoolToVisibility}}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="4"
                                                        Padding="4,1"
                                                        CornerRadius="3"
                                                        Background="#B0000000">
                                                    <TextBlock Text="{DynamicResource LOCImageRotaterAnimatedBadge}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>

                                                <!-- Length, on video results only.
                                                     A background loops, so a 20-second
                                                     clip reads very differently from a
                                                     ten-minute one - and it is the only
                                                     hint before committing to a download.

                                                     Bottom LEFT. It was bottom-right,
                                                     underneath the preview button, which
                                                     is 26x26, opaque, in the same cell and
                                                     declared after it - so a later sibling
                                                     painted straight over it and the
                                                     duration was never once visible. The
                                                     button's own comment says it was put
                                                     there to clear the ANIMATED badge and
                                                     the tick; this badge arrived
                                                     afterwards and took the last free
                                                     corner it did not have. -->
                                                <Border Visibility="{Binding IsYouTube, Converter={StaticResource BoolToVisibility}}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Margin="4"
                                                        Padding="4,1"
                                                        CornerRadius="3"
                                                        Background="#B0000000">
                                                    <TextBlock Text="{Binding DurationText}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>

                                                <!-- Only shown once selected, so an
                                                     unpicked grid stays uncluttered. -->
                                                <Border x:Name="Tick"
                                                        Visibility="Collapsed"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="4"
                                                        Width="22" Height="22"
                                                        CornerRadius="11"
                                                        Background="{DynamicResource GlyphBrush}">
                                                    <TextBlock Text="&#x2713;"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrushDarker}"/>
                                                </Border>

                                                <!-- Opens the full image, at size, in its own
                                                     window - and it is where an animated result
                                                     actually plays.

                                                     A thumbnail says almost nothing about whether a
                                                     1920x620 banner is the right shape for a
                                                     background, or how much a GIF actually moves.
                                                     Bottom-right so it does not sit under the GIF
                                                     badge or the selection tick. -->
                                                <Button Content="&#x1F441;"
                                                        ToolTip="{DynamicResource LOCImageRotaterPreviewFullTooltip}"
                                                        Click="Preview_Click"
                                                        Tag="{Binding}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="4"
                                                        Width="26" Height="26"
                                                        Padding="0"
                                                        FontSize="13"
                                                        Focusable="False"/>
                                            </Grid>

                                            <!-- Size and the real file format. The
                                                 format matters because WPF cannot
                                                 display all of them - a WEBP will
                                                 not show here even though it
                                                 downloads fine.

                                                 CaptionText rather than Dimensions:
                                                 a YouTube result has no size to state.
                                                 See the property. -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,4,0,0">
                                                <TextBlock Text="{Binding CaptionText}"/>
                                                <TextBlock Text="{Binding FormatLabel}"
                                                           Margin="6,0,0,0"
                                                           Foreground="Gray"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Style}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                                            <Setter TargetName="Frame" Property="Background" Value="#173640"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Frame" Property="Background" Value="#17242B"/>
                                        </Trigger>

                                        <!-- Where the D-pad is.
                                             Without this a controller user has no
                                             idea which tile Enter would activate -
                                             the tick marks what is SELECTED, which
                                             is a different question. Brighter than
                                             the hover wash so the two read apart
                                             when a mouse and a pad are both in
                                             use. -->
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Frame" Property="Background" Value="#173640"/>
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="#39C6D4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

                <Border x:Name="EmptyResultsPanel"
                        Grid.Row="1"
                        Background="#0B1216"
                        BorderBrush="#263841"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasItems, ElementName=ResultsList}" Value="False"/>
                                        <Condition Binding="{Binding IsBusy}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                        <TextBlock Text="{DynamicResource LOCImageRotaterNoResultsTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Status}"
                                   Foreground="#95A5AE"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Preview panel.
                 In the dialog rather than a modal window on purpose: a modal
                 has to be dismissed before the next result can be looked at,
                 which makes comparing two candidates a chore. This stays open
                 while the grid is browsed. -->
            <Border x:Name="PreviewPanel"
                    Grid.Column="3"
                    Margin="12,0,0,0"
                    Padding="10"
                    Background="#10181D"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#294C58"
                    Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="PreviewCloseButton"
                                Content="&#x2715;"
                                DockPanel.Dock="Right"
                                Width="24"
                                Height="24"
                                Padding="0"
                                ToolTip="{DynamicResource LOCImageRotaterClosePreviewTooltip}"
                                Click="PreviewClose_Click"/>
                        <TextBlock x:Name="PreviewTitle"
                                   Text="{DynamicResource LOCImageRotaterPreview}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <TextBlock x:Name="PreviewStatus"
                               DockPanel.Dock="Bottom"
                               FontSize="11"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <!-- Both renderers live here; whichever is unused stays
                         collapsed. Swapping children at runtime instead would
                         mean rebuilding the visual tree on every preview. -->
                    <Grid>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        <!-- The web view is added here in code, not markup.
                             It needs its environment created before it can be
                             initialised, and that is async - which XAML cannot
                             express. See PreviewRenderer. -->
                        <ContentControl x:Name="PreviewVideoHost"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Dedicated download popup: visible above the manager instead of being
             embedded in the results area. The popup stays open while work is in
             progress, then closes automatically after success/error feedback. -->
        <Popup x:Name="DownloadFeedbackPopup"
               Placement="Center"
               PlacementTarget="{Binding ElementName=SearchRoot}"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border Padding="20,16"
                    MinWidth="360"
                    MaxWidth="560"
                    Background="#17242A"
                    BorderBrush="#39C6D4"
                    BorderThickness="1.5"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#102E36"
                            BorderBrush="#2D6671"
                            BorderThickness="1"
                            VerticalAlignment="Top"
                            Margin="0,0,14,0">
                        <TextBlock x:Name="DownloadFeedbackIcon"
                                   Text="&#x2193;"
                                   Foreground="#55C8D8"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DownloadFeedbackText"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <ProgressBar x:Name="DownloadProgress"
                                     Height="5"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- Compact footer: pagination + actions only. -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVisibility}}">
                <Button Content="&#x25C0;"
                        Width="34"
                        Padding="0"
                        IsEnabled="{Binding CanGoBack}"
                        Click="PreviousPage_Click"/>
                <TextBlock Text="{Binding PageLabel}"
                           VerticalAlignment="Center"
                           Margin="10,0"
                           FontSize="11"/>
                <Button Content="&#x25B6;"
                        Width="34"
                        Padding="0"
                        IsEnabled="{Binding CanGoForward}"
                        Click="NextPage_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="DownloadButton"
                        Content="{DynamicResource LOCImageRotaterDownloadSelected}"
                        MinWidth="150"
                        Style="{StaticResource DownloadActionButton}"
                        Click="DownloadButton_Click"/>
                <Button x:Name="CloseDialogButton"
                        Content="{DynamicResource LOCImageRotaterClose}"
                        MinWidth="90"
                        Margin="8,0,0,0"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
