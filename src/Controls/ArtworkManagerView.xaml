<UserControl x:Class="ImageRotater.Controls.ArtworkManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1260">

    <UserControl.Resources>
        <ResourceDictionary Source="/ImageRotater;component/Controls/ArtworkManagerResources.xaml"/>
</UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#B811191E"
                CornerRadius="10"
                Padding="7"
                HorizontalAlignment="Left"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LocalNavButton"
                             GroupName="ManagerPages"
                             Style="{StaticResource ManagerPageNavStyle}"
                             IsChecked="True"
                             Margin="0,0,10,0"
                             Checked="ManagerNav_Checked"/>
                <RadioButton x:Name="SearchNavButton"
                             GroupName="ManagerPages"
                             Style="{StaticResource ManagerPageNavStyle}"
                             Content="{DynamicResource LOCImageRotaterManagerSearchTab}"
                             Checked="ManagerNav_Checked"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="ManagerTabs"
                    Grid.Row="1"
                    Style="{StaticResource ManagerTabControlStyle}"
                    SelectionChanged="ManagerTabs_SelectionChanged">
            <TabItem x:Name="LocalTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="470"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Visual collection, inspired by BackgroundChanger but less dense. -->
                        <Border Grid.Column="0" Style="{StaticResource ManagerCardStyle}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="2,0,2,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FilesHeaderText"
                                               Grid.Column="0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ManagerGoldBrush}"/>
                                    <TextBlock x:Name="SelectionSummaryText"
                                               Grid.Column="1"
                                               Margin="14,0,0,0"
                                               Foreground="{StaticResource ManagerMutedBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <ListView x:Name="ItemsList"
                                              AllowDrop="True"
                                              DragOver="ItemsList_DragOver"
                                              Drop="ItemsList_Drop"
                                              Style="{StaticResource ArtworkListViewStyle}"
                                              SelectionMode="Extended"
                                              IsTabStop="False"
                                              ItemContainerStyle="{StaticResource ArtworkListItemStyle}"
                                              SelectionChanged="ItemsList_SelectionChanged"
                                              MouseDoubleClick="ItemsList_MouseDoubleClick"
                                              PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ContextMenu>
                                            <ContextMenu Opened="ArtworkContextMenu_Opened">
                                                <MenuItem x:Name="SetFixedArtworkMenuItem" Header="{DynamicResource LOCImageRotaterManagerSetFixedArtwork}" Click="ContextSetFixed_Click"/>
                                                <MenuItem x:Name="ToggleExcludeMenuItem" Header="{DynamicResource LOCImageRotaterManagerExcludeRotation}" Click="ContextToggleExclude_Click"/>
                                                <Separator/>
                                                <MenuItem x:Name="MoveUpMenuItem" Header="{DynamicResource LOCImageRotaterManagerMoveUp}" Click="ContextMoveUp_Click"/>
                                                <MenuItem x:Name="MoveDownMenuItem" Header="{DynamicResource LOCImageRotaterManagerMoveDown}" Click="ContextMoveDown_Click"/>
                                                <MenuItem x:Name="MoveTopMenuItem" Header="{DynamicResource LOCImageRotaterManagerMoveTop}" Click="ContextMoveTop_Click"/>
                                                <MenuItem x:Name="MoveBottomMenuItem" Header="{DynamicResource LOCImageRotaterManagerMoveBottom}" Click="ContextMoveBottom_Click"/>
                                                <Separator/>
                                                <MenuItem Header="{DynamicResource LOCImageRotaterManagerOpenFileLocation}" Click="ContextOpenFileLocation_Click"/>
                                                <MenuItem x:Name="DeleteArtworkMenuItem" Header="{DynamicResource LOCImageRotaterManagerDeleteArtwork}" Click="ContextDelete_Click"/>
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="108"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="108"
                                                            Height="68"
                                                            Background="#C20B1115"
                                                            CornerRadius="6"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <Image Source="{Binding ThumbnailSource}"
                                                                   Stretch="UniformToFill"/>
                                                            <Border Visibility="{Binding OriginalBadgeVisibility}"
                                                                    BorderBrush="{StaticResource ManagerGoldBrush}"
                                                                    BorderThickness="2"
                                                                    CornerRadius="6"
                                                                    IsHitTestVisible="False"/>
                                                            <Border Background="#99000000"
                                                                    CornerRadius="4"
                                                                    Padding="5,2"
                                                                    Margin="5"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding TypeLabel}"
                                                                           Foreground="White"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Text="▶"
                                                                       Visibility="{Binding VideoIconVisibility}"
                                                                       Foreground="White"
                                                                       FontSize="22"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <Border Background="#202C33" BorderBrush="#52616A" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding OrderLabel}" Foreground="#CAD4D9" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border Visibility="{Binding OriginalBadgeVisibility}" Background="#332A2112" BorderBrush="{StaticResource ManagerGoldBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                                    <TextBlock Text="{DynamicResource LOCImageRotaterManagerOriginal}" Foreground="{StaticResource ManagerGoldBrush}" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border Visibility="{Binding FixedBadgeVisibility}" Background="#173640" BorderBrush="{StaticResource ManagerAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                                    <TextBlock Text="{DynamicResource LOCImageRotaterFixedArtwork}" Foreground="{StaticResource ManagerAccentBrush}" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border Visibility="{Binding ExcludedBadgeVisibility}" Background="#382326" BorderBrush="#B96B72" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,8,0">
                                                                    <TextBlock Text="{DynamicResource LOCImageRotaterManagerExcluded}" Foreground="#F0A0A7" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding DetailsLabel}"
                                                                   Foreground="{StaticResource ManagerMutedBrush}"
                                                                   FontSize="11"
                                                                   Margin="0,5,0,0"/>
                                                        <TextBlock Text="{Binding ModifiedLabel}"
                                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                                   FontSize="10"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <!-- Actionable empty state rather than an unexplained blank list. -->
                                    <StackPanel x:Name="EmptyStatePanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                MaxWidth="330"
                                                Visibility="Collapsed">
                                        <TextBlock Text="＋"
                                                   FontSize="34"
                                                   Foreground="{StaticResource ManagerAccentBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="EmptyListText"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock Text="{DynamicResource LOCImageRotaterManagerEmptyHelp}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Foreground="{StaticResource ManagerMutedBrush}"
                                                   Margin="0,5,0,14"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="{DynamicResource LOCImageRotaterManagerAddFiles}"
                                                    Style="{StaticResource ManagerPrimaryButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Click="AddButton_Click"/>
                                            <Button Content="{DynamicResource LOCImageRotaterManagerFindOnline}"
                                                    Style="{StaticResource ManagerSecondaryButtonStyle}"
                                                    Click="OpenSearchButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Persistent preview, one of BackgroundChanger's strongest UX choices. -->
                        <Border Grid.Column="2" Style="{StaticResource ManagerCardStyle}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="2,0,2,10">
                                    <TextBlock Text="{DynamicResource LOCImageRotaterPreview}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ManagerGoldBrush}"/>
                                </DockPanel>

                                <Border Grid.Row="1"
                                        Background="#C20B1115"
                                        BorderBrush="#253941"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="8">
                                    <Grid>
                                        <Image x:Name="PreviewImage"
                                               Stretch="Uniform"
                                               Visibility="Collapsed"/>
                                        <MediaElement x:Name="PreviewVideo"
                                                      LoadedBehavior="Manual"
                                                      UnloadedBehavior="Manual"
                                                      Stretch="Uniform"
                                                      Visibility="Collapsed"
                                                      MediaEnded="PreviewVideo_MediaEnded"
                                                      MediaFailed="PreviewVideo_MediaFailed"/>
                                        <StackPanel x:Name="PreviewEmptyPanel"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="420">
                                            <TextBlock Text="▧"
                                                       FontSize="40"
                                                       Foreground="{DynamicResource TextBrushDarker}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="PreviewHintText"
                                                       Foreground="{StaticResource ManagerMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2"
                                        Background="#C410181D"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="PreviewNameText"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="PreviewMetaText"
                                                   Foreground="{StaticResource ManagerMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <!-- Only shown for a selected animated WebP from ImageRotater's own library. -->
                                        <Button x:Name="ConvertWebpButton"
                                                Content="{DynamicResource LOCImageRotaterManagerWebpConvert}"
                                                Visibility="Collapsed"
                                                Style="{StaticResource ManagerPrimaryButtonStyle}"
                                                HorizontalAlignment="Left"
                                                MinWidth="150"
                                                Margin="0,12,0,0"
                                                Click="ConvertWebpButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource ManagerCardStyle}" Padding="12" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource LOCImageRotaterManagerGameRotationMode}" Foreground="{StaticResource ManagerMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="GameModeOverrideCombo" Grid.Column="1" Style="{StaticResource ManagerComboStyle}" DisplayMemberPath="Label" SelectionChanged="GameModeOverrideCombo_SelectionChanged"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource LOCImageRotaterManagerGameSelectionMethod}" Foreground="{StaticResource ManagerMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="GameOrderOverrideCombo" Grid.Column="4" Style="{StaticResource ManagerComboStyle}" DisplayMemberPath="Label" SelectionChanged="GameOrderOverrideCombo_SelectionChanged"/>
                            <TextBlock Grid.Column="5" Text="{DynamicResource LOCImageRotaterManagerGameBehaviorHint}" Foreground="{DynamicResource TextBrushDarker}" VerticalAlignment="Center" Margin="18,0,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Bottom action bar: common actions on the left, contextual hint on the right. -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="LocalActionsPanel"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Button x:Name="AddButton"
                                    Content="{DynamicResource LOCImageRotaterManagerAddArtwork}"
                                    Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    MinWidth="125"
                                    Margin="0,0,8,0"
                                    Click="AddButton_Click"/>
                            <Button x:Name="AutomaticButton"
                                    Content="{DynamicResource LOCImageRotaterManagerAutoFind}"
                                    Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    MinWidth="165"
                                    Margin="0,0,8,0"
                                    Click="AutomaticButton_Click"/>
                            <Button x:Name="SetFixedArtworkButton"
                                    Visibility="Collapsed"
                                    Content="{DynamicResource LOCImageRotaterManagerSetFixedArtwork}"
                                    ToolTip="{DynamicResource LOCImageRotaterManagerSetFixedArtworkHelp}"
                                    Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    MinWidth="150"
                                    Margin="0,0,16,0"
                                    Click="SetFixedArtworkButton_Click"/>
                            <Button x:Name="MoveUpButton"
                                    Visibility="Collapsed"
                                    Content="{DynamicResource LOCImageRotaterManagerMoveUp}"
                                    ToolTip="{DynamicResource LOCImageRotaterManagerMoveOrderHelp}"
                                    Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    MinWidth="82"
                                    Margin="0,0,8,0"
                                    Click="MoveArtworkButton_Click"/>
                            <Button x:Name="MoveDownButton"
                                    Visibility="Collapsed"
                                    Content="{DynamicResource LOCImageRotaterManagerMoveDown}"
                                    ToolTip="{DynamicResource LOCImageRotaterManagerMoveOrderHelp}"
                                    Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    MinWidth="82"
                                    Margin="0,0,16,0"
                                    Click="MoveArtworkButton_Click"/>
                            <Button x:Name="OpenFolderButton"
                                    Visibility="Collapsed"
                                    Content="{DynamicResource LOCImageRotaterMenuOpenFolder}"
                                    Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    MinWidth="105"
                                    Margin="0,0,8,0"
                                    Click="OpenFolderButton_Click"/>
                            <Button x:Name="RefreshButton"
                                    Content="{DynamicResource LOCImageRotaterManagerRefresh}"
                                    Style="{StaticResource ManagerSecondaryButtonStyle}"
                                    MinWidth="90"
                                    Margin="0"
                                    Click="RefreshButton_Click"/>
                            <Button x:Name="DeleteButton"
                                    Visibility="Collapsed"
                                    Content="{DynamicResource LOCImageRotaterManagerDeleteSelected}"
                                    Style="{StaticResource ManagerDangerButtonStyle}"
                                    MinWidth="130"
                                    Click="DeleteButton_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource LOCImageRotaterManagerRightClickHint}"
                                   Foreground="{DynamicResource TextBrushDarker}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="20,0,8,0"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="SearchTab" Header="{DynamicResource LOCImageRotaterManagerSearchTab}">
                <Border Style="{StaticResource ManagerCardStyle}" Padding="6">
                    <ContentControl x:Name="SearchHost"/>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
