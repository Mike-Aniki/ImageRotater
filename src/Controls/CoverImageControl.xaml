<c:PluginUserControl x:Class="ImageRotater.Controls.CoverImageControl"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:c="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK">
    <Grid x:Name="RootGrid" ClipToBounds="True">

        <!-- IsAsync=True is the load-bearing part, not a tuning choice.
             Fullscreen realises many tiles at once, and a synchronous decode
             inside the layout pass is what took Playnite down when an earlier
             version of this control was placed in a grid template. Binding a
             PATH asynchronously moves the decode off that thread.

             UniformToFill is only the safe XAML fallback. At runtime the
             code-behind reads Playnite's native CoverArtStretch setting. A
             theme can override Stretch and StretchDirection per
             ImageRotater_Cover host; if it does not, the native Playnite
             behaviour remains the fallback. -->
        <!-- NotifyOnTargetUpdated is what drives the crossfade.
             The binding is asynchronous, so the new picture arrives some time
             after the path is set and there is no way to know when from the
             code that set it. TargetUpdated fires exactly then, which is the
             only correct moment to dissolve the old layer away. -->
        <Image x:Name="DisplayImage"
               Stretch="UniformToFill"
               StretchDirection="Both"
               RenderOptions.BitmapScalingMode="Linear"
               TargetUpdated="DisplayImage_TargetUpdated"
               Source="{Binding ImagePath, IsAsync=True, NotifyOnTargetUpdated=True}"/>

        <!-- The OUTGOING cover, and it must be declared AFTER DisplayImage.
             Later children of a Grid draw on top, and this one has to be the
             layer that fades AWAY - revealing the new picture already opaque
             beneath it. Declared first, it sat underneath and dissolved while
             completely hidden by the incoming cover: the animation ran
             perfectly and was invisible, which looked like the fade doing
             nothing at all.

             One Image cannot dissolve into another - assigning Source is
             instant - so two layers is the only way, and it is how Playnite's
             own FadeImage does it. -->
        <Image x:Name="PreviousImage"
               Stretch="UniformToFill"
               StretchDirection="Both"
               RenderOptions.BitmapScalingMode="Linear"
               Visibility="Collapsed"
               IsHitTestVisible="False"/>

        <!-- The flash for the fade-through-colour transitions: raised over
             both still layers before the new picture is requested, lowered
             once it has arrived. Sits below the video, which has its own
             fades. See Transition. -->
        <Rectangle x:Name="Veil"
                   Opacity="0"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>

        <!-- Two lightweight shutters used by the Black bars transition. -->
<!-- Video artwork, a renderer the Image cannot be: WPF's imaging stack
             does not decode containers. Only one of the two draws at a time.

             LoadedBehavior=Manual so Play/Stop can be driven from code-behind -
             the default starts on load and ignores those calls. Always muted:
             a library that made noise while you scrolled it would be a bug.

             UnloadedBehavior=Manual is load-bearing in a Fullscreen grid, and
             the default (Close) is what broke selection: selecting a tile runs
             Focus() then BringIntoView(), which re-measures the tile panel and
             REMOVES AND RE-INSERTS containers. That is an Unload/Load cycle on
             this element, so the media was torn down the instant a tile became
             selected - the video vanished and a still showed through, while
             the code-behind logged a perfectly correct Play() on the right
             file. Manual keeps the media alive across the cycle; the Loaded
             handler restarts playback afterwards. Same shape BackgroundChanger
             uses to survive the same recycle. -->
        <MediaElement x:Name="DisplayVideo"
                      Visibility="Collapsed"
                      Stretch="UniformToFill"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Loaded="DisplayVideo_Loaded"
                      IsMuted="True"
                      ScrubbingEnabled="False"
                      MediaOpened="DisplayVideo_MediaOpened"
                      MediaEnded="DisplayVideo_MediaEnded"
                      MediaFailed="DisplayVideo_MediaFailed"/>

        <!-- Shown only when a path exists but will not load, which is a real
             fault worth surfacing. A game with no plugin cover renders nothing
             so the theme's own artwork shows through - that is not an error. -->
        <Viewbox x:Name="MissingImagePlaceholder"
                 Visibility="Collapsed"
                 Tag="{DynamicResource TextBrush}"
                 Width="64" Height="64"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Opacity="0.28">
            <Canvas Width="24" Height="24">
                <Path Data="M3,3 H21 V21 H3 Z"
                      Stroke="{Binding Tag, ElementName=MissingImagePlaceholder, TargetNullValue=#FFCCCCCC, FallbackValue=#FFCCCCCC}"
                      StrokeThickness="1.2"
                      Fill="Transparent"/>
                <Path Data="M9.2,9.1 C9.2,7.7 10.4,6.8 12,6.8 C13.6,6.8 14.8,7.7 14.8,9.1 C14.8,10.6 13.4,10.9 12.6,11.8 C12.2,12.3 12.1,12.8 12.1,13.6"
                      Stroke="{Binding Tag, ElementName=MissingImagePlaceholder, TargetNullValue=#FFCCCCCC, FallbackValue=#FFCCCCCC}"
                      StrokeThickness="1.4"
                      Fill="Transparent"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="11.35" Canvas.Top="15.2"
                         Width="1.4" Height="1.4"
                         Fill="{Binding Tag, ElementName=MissingImagePlaceholder, TargetNullValue=#FFCCCCCC, FallbackValue=#FFCCCCCC}"/>
            </Canvas>
        </Viewbox>

    </Grid>
</c:PluginUserControl>
