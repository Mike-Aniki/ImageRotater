<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net4.6.2</TargetFramework>
        <UseWPF>true</UseWPF>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <RootNamespace>ImageRotater</RootNamespace>
        <AssemblyName>ImageRotater</AssemblyName>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <LangVersion>7.3</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>portable</DebugType>
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>portable</DebugType>
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="PlayniteSDK" Version="6.16.0.0" PrivateAssets="none" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
        <!-- GIF playback on a plain Image via an attached property. The same
             library PlayGif ships; MIT; static formats untouched. -->
        <PackageReference Include="XamlAnimatedGif" Version="2.3.0" />

        <!-- Renders the animated preview.
             WPF's own MediaElement cannot do this job here: setting its Source
             succeeds and then it dies with a NullReferenceException inside
             MediaPlayerState during rendering, taking the window with it -
             reproduced outside Playnite, for both a remote URL and a local
             file, so it is the control rather than the media.
             A web view also plays WebM and animated WebP, which MediaElement
             never could, so this covers every format the search can return.
             Same package PlayGif uses. -->
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    </ItemGroup>

    <!-- Framework assembly, not a package: on .NET Framework System.Net.Http
         ships with the runtime but still needs an explicit reference. -->
    <ItemGroup>
        <Reference Include="System.Net.Http" />
    </ItemGroup>

    <ItemGroup>
        <Page Remove="Localization\**\*.xaml" />
        <Content Include="Localization\**\*.xaml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\extension.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\icon.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\LICENSE">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
